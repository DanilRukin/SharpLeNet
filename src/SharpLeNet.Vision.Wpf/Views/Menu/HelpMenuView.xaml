<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Menu.HelpMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:menu="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels.Menu"
             xmlns:converters="clr-namespace:SharpLeNet.Vision.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="550"
             d:DataContext="{d:DesignInstance menu:HelpMenuViewModel}">

    <Border Style="{StaticResource MenuModalStyle}" Width="550">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource MenuHeaderStyle}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="48" Height="48"
                                Background="{StaticResource Gold500Brush}"
                                Opacity="0.1"
                                BorderBrush="{StaticResource Gold400Brush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Path Data="{StaticResource HelpCircleIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Центр поддержки"
                                      Foreground="White"
                                      FontSize="18"
                                      FontWeight="Bold"/>
                            <TextBlock Text="SharpLeNet Vision Help System"
                                      Foreground="{StaticResource White40Brush}"
                                      FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource MenuCloseButtonStyle}"
                            Command="{Binding CloseCommand}">
                        <Path Data="{StaticResource XIconGeometry}"
                              Stroke="{StaticResource White40Brush}"
                              StrokeThickness="2"
                              Width="20" Height="20"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16"
                          Background="Transparent"
                          MaxHeight="500">

                <StackPanel>
                    <!-- Group 1: Documentation & Learning -->
                    <TextBlock Text="ДОКУМЕНТАЦИЯ И ОБУЧЕНИЕ"
                              Style="{StaticResource MenuSectionStyle}"/>

                    <!-- Quick Start -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding QuickStartCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Margin="0, -1, 12, 0"
                                  Data="{StaticResource GraduationCapIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"/>

                            <TextBlock Grid.Column="1"
                                      Text="Быстрый старт"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Path Grid.Column="2"
                                  Margin="5, 0, 0, -2"
                                  Data="{StaticResource ChevronRightIconGeometry}"
                                  Stroke="{StaticResource White20Brush}"
                                  StrokeThickness="2"
                                  Width="14" Height="14"
                                  Stretch="Uniform"/>
                        </Grid>
                    </Button>

                    <!-- User Guide -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding UserGuideCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource BookOpenIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Руководство пользователя"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Path Grid.Column="2"
                                  Margin="5, 0, 0, -2"
                                  Data="{StaticResource ChevronRightIconGeometry}"
                                  Stroke="{StaticResource White20Brush}"
                                  StrokeThickness="2"
                                  Width="14" Height="14"
                                  Stretch="Uniform"/>
                        </Grid>
                    </Button>

                    <!-- Architecture Reference -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ArchitectureReferenceCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource LayersIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Справочник архитектур"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>
                        </Grid>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource White5Brush}" Margin="0,16"/>

                    <!-- Group 2: Tutorials & Resources -->
                    <TextBlock Text="МАТЕРИАЛЫ И РЕСУРСЫ"
                              Style="{StaticResource MenuSectionStyle}"/>

                    <!-- Video Tutorials -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding VideoTutorialsCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource PlayCircleIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Видео-уроки"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Path Grid.Column="2"
                                  Data="{StaticResource ExternalLinkIconGeometry}"
                                  Stroke="{StaticResource White20Brush}"
                                  StrokeThickness="2"
                                  Width="14" Height="14"
                                  Stretch="Uniform"/>
                        </Grid>
                    </Button>

                    <!-- Keyboard Shortcuts -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding KeyboardShortcutsCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource KeyboardIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Горячие клавиши"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="Ctrl + ?"
                                      Foreground="{StaticResource White20Brush}"
                                      FontSize="10"
                                      FontFamily="Consolas"/>
                        </Grid>
                    </Button>

                    <!-- Pro Tips -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ProTipsCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource SparklesIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Советы профи"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>
                        </Grid>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource White5Brush}" Margin="0,16"/>

                    <!-- Group 3: Community & Support -->
                    <TextBlock Text="ОБРАТНАЯ СВЯЗЬ"
                              Style="{StaticResource MenuSectionStyle}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Report Bug -->
                        <Button Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource MenuItemStyle}"
                                Height="80"
                                Margin="0,0,4,4"
                                Command="{Binding ReportBugCommand}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource BugIconGeometry}"
                                      Fill="{StaticResource Rose400Brush}"
                                      Width="28" Height="28"
                                      Stretch="Uniform"
                                      Margin="0,0,0,8"/>
                                <TextBlock Text="Сообщить о баге"
                                          Foreground="White"
                                          FontSize="11"
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- GitHub -->
                        <Button Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource MenuItemStyle}"
                                Height="80"
                                Margin="4,0,0,4"
                                Command="{Binding OpenGitHubCommand}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource GithubIconGeometry}"
                                      Fill="{StaticResource White70Brush}"
                                      Width="28" Height="28"
                                      Stretch="Uniform"
                                      Margin="0,0,0,8"/>
                                <TextBlock Text="GitHub"
                                          Foreground="White"
                                          FontSize="11"
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Discord -->
                        <Button Grid.Row="1" Grid.Column="0"
                                Style="{StaticResource MenuItemStyle}"
                                Height="80"
                                Margin="0,4,4,0"
                                Command="{Binding JoinDiscordCommand}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource MessageSquareIconGeometry}"
                                      Fill="{StaticResource Indigo400Brush}"
                                      Width="28" Height="28"
                                      Stretch="Uniform"
                                      Margin="0,0,0,8"/>
                                <TextBlock Text="Discord"
                                          Foreground="White"
                                          FontSize="11"
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Suggest Feature -->
                        <Button Grid.Row="1" Grid.Column="1"
                                Style="{StaticResource MenuItemStyle}"
                                Height="80"
                                Margin="4,4,0,0"
                                Command="{Binding SuggestFeatureCommand}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource LightbulbIconGeometry}"
                                      Fill="{StaticResource Gold400Brush}"
                                      Width="28" Height="28"
                                      Stretch="Uniform"
                                      Margin="0,0,0,8"/>
                                <TextBlock Text="Предложить фичу"
                                          Foreground="White"
                                          FontSize="11"
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource White5Brush}" Margin="0,16"/>

                    <!-- Group 4: About -->
                    <TextBlock Text="О ПРОГРАММЕ"
                              Style="{StaticResource MenuSectionStyle}"/>

                    <!-- About -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding AboutCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource InfoIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="О программе"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="{Binding AppVersion}"
                                      Foreground="{StaticResource White20Brush}"
                                      FontSize="10"
                                      FontFamily="Consolas"/>
                        </Grid>
                    </Button>

                    <!-- Check Updates -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding CheckUpdatesCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource RefreshCcwIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Проверить обновления"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource Coal900Brush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SharpLeNet Vision"
                                  Foreground="{StaticResource White40Brush}"
                                  FontSize="10"
                                  FontWeight="Black"/>
                        <TextBlock Text="© 2026 RukinStudio. All rights reserved."
                                  Foreground="{StaticResource White20Brush}"
                                  FontSize="9"
                                  FontFamily="Consolas"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                        <Border Width="32" Height="32"
                                Background="{StaticResource White5Brush}"
                                CornerRadius="8"
                                Margin="0,0,8,0">
                            <Path Data="{StaticResource CpuIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                        <Border Width="32" Height="32"
                                Background="{StaticResource White5Brush}"
                                CornerRadius="8">
                            <Path Data="{StaticResource ZapIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>