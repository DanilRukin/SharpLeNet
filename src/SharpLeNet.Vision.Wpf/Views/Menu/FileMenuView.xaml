<!-- Views/Menu/FileMenuView.xaml -->
<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Menu.FileMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:menu="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels.Menu"
             xmlns:converters="clr-namespace:SharpLeNet.Vision.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance menu:FileMenuViewModel}">

    <UserControl.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <converters:IconToGeometryConverter x:Key="IconToGeometryConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource MenuModalStyle}" Width="500">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource MenuHeaderStyle}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="40" Height="40"
                                Background="{StaticResource Gold500Brush}"
                                Opacity="0.1"
                                BorderBrush="{StaticResource Gold400Brush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Path Data="{StaticResource FileIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Меню Файл"
                                      Foreground="White"
                                      FontSize="16"
                                      FontWeight="Bold"/>
                            <TextBlock Text="Управление проектами и экспортом"
                                      Foreground="{StaticResource White40Brush}"
                                      FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource MenuCloseButtonStyle}"
                            Command="{Binding CloseCommand}">
                        <Path Data="{StaticResource XIconGeometry}"
                              Stroke="{StaticResource White40Brush}"
                              StrokeThickness="2"
                              Width="18" Height="18"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16"
                          Background="Transparent">

                <StackPanel>
                    <!-- Group 1: Basic Operations -->
                    <TextBlock Text="ОСНОВНЫЕ ОПЕРАЦИИ"
                              Style="{StaticResource MenuSectionStyle}"/>

                    <!-- New Project -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding NewProjectCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource FilePlusIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Новый проект"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="Ctrl+N"
                                      Style="{StaticResource ShortcutStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Open Project -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding OpenProjectCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource FolderOpenIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Открыть проект"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="Ctrl+O"
                                      Style="{StaticResource ShortcutStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Recent Files Section -->
                    <Border Background="{StaticResource White5Brush}"
                            CornerRadius="12"
                            Margin="0,8,0,16"
                            Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource HistoryIconGeometry}"
                                      Fill="{StaticResource White20Brush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1"
                                          Text="Последние открытые"
                                          Foreground="{StaticResource White20Brush}"
                                          FontSize="9"
                                          FontWeight="Bold"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RecentProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TextButtonStyle}"
                                                Height="32"
                                                HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                          Text="{Binding Name}"
                                                          Foreground="{StaticResource White60Brush}"
                                                          FontSize="11"/>
                                                <TextBlock Grid.Column="1"
                                                          Text="{Binding TimeAgo}"
                                                          Foreground="{StaticResource White20Brush}"
                                                          FontSize="10"
                                                          FontFamily="Consolas"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource White5Brush}" Margin="0,8"/>

                    <!-- Group 2: Saving -->
                    <TextBlock Text="СОХРАНЕНИЕ"
                              Style="{StaticResource MenuSectionStyle}"
                              Margin="0,16,0,8"/>

                    <!-- Save -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding SaveProjectCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource SaveIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Сохранить"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="Ctrl+S"
                                      Style="{StaticResource ShortcutStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Save As -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding SaveAsCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource CopyIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Сохранить как..."
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="Ctrl+Shift+S"
                                      Style="{StaticResource ShortcutStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource White5Brush}" Margin="0,8"/>

                    <!-- Group 3: Data Exchange -->
                    <TextBlock Text="ОБМЕН ДАННЫМИ"
                              Style="{StaticResource MenuSectionStyle}"
                              Margin="0,16,0,8"/>

                    <!-- Export Model -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ExportModelCommand}"
                            Height="56">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource DownloadIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Экспорт модели"
                                          Foreground="{StaticResource White80Brush}"
                                          FontSize="13"/>
                                <TextBlock Text="Сохранить веса в формате .pth"
                                          Foreground="{StaticResource White30Brush}"
                                          FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Import Weights -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ImportWeightsCommand}"
                            Height="56">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource UploadIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Импорт весов"
                                          Foreground="{StaticResource White80Brush}"
                                          FontSize="13"/>
                                <TextBlock Text="Загрузить предтренированные веса"
                                          Foreground="{StaticResource White30Brush}"
                                          FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource White5Brush}" Margin="0,8"/>

                    <!-- Group 4: Settings -->
                    <TextBlock Text="НАСТРОЙКИ"
                              Style="{StaticResource MenuSectionStyle}"
                              Margin="0,16,0,8"/>

                    <!-- Project Settings -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ProjectSettingsCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource Settings2IconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Настройки проекта"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="Alt+Enter"
                                      Style="{StaticResource ShortcutStyle}"/>
                        </Grid>
                    </Button>

                    <!-- App Settings -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding AppSettingsCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource SlidersIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Параметры приложения"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer with Exit -->
            <Border Grid.Row="2"
                    Background="{StaticResource Coal900Brush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Button Style="{StaticResource MenuItemStyle}"
                        Command="{Binding ExitCommand}"
                        Height="48"
                        Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="{StaticResource LogOutIconGeometry}"
                              Fill="{StaticResource Rose400Brush}"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="1"
                                  Text="Выйти из SharpLeNet"
                                  Foreground="{StaticResource Rose400Brush}"
                                  FontSize="13"
                                  FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="2"
                                  Text="Ctrl+Q"
                                  Foreground="{StaticResource Rose400Brush}"
                                  FontSize="10"
                                  FontFamily="Consolas"
                                  Opacity="0.5"/>
                    </Grid>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>