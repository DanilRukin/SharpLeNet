<!-- Views/Menu/ViewMenuView.xaml -->
<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Menu.ViewMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:menu="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels.Menu"
             xmlns:converters="clr-namespace:SharpLeNet.Vision.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance menu:ViewMenuViewModel}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource MenuModalStyle}" Width="500">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource MenuHeaderStyle}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="40" Height="40"
                                Background="{StaticResource Gold500Brush}"
                                Opacity="0.1"
                                BorderBrush="{StaticResource Gold400Brush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Path Data="{StaticResource EyeIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Меню Вид"
                                      Foreground="White"
                                      FontSize="16"
                                      FontWeight="Bold"/>
                            <TextBlock Text="Настройка интерфейса и сетки"
                                      Foreground="{StaticResource White40Brush}"
                                      FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource MenuCloseButtonStyle}"
                            Command="{Binding CloseCommand}">
                        <Path Data="{StaticResource XIconGeometry}"
                              Stroke="{StaticResource White40Brush}"
                              StrokeThickness="2"
                              Width="18" Height="18"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16"
                          Background="Transparent">

                <StackPanel>
                    <!-- Section 1: Scale & Screen -->
                    <TextBlock Text="МАСШТАБ И ЭКРАН"
                              Style="{StaticResource MenuSectionStyle}"/>

                    <!-- Full Screen -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ToggleFullScreenCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource MaximizeIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Полноэкранный режим"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="F11"
                                      Style="{StaticResource ShortcutStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Zoom In -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ZoomInCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource ZoomInIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Увеличить"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="Ctrl +"
                                      Style="{StaticResource ShortcutStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Zoom Out -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ZoomOutCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource ZoomOutIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Уменьшить"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="Ctrl -"
                                      Style="{StaticResource ShortcutStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Reset Zoom -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ResetZoomCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource RefreshCcwIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Сбросить зум"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <TextBlock Grid.Column="2"
                                      Text="Ctrl 0"
                                      Style="{StaticResource ShortcutStyle}"/>
                        </Grid>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource White5Brush}" Margin="0,16"/>

                    <!-- Section 2: Panel Visibility -->
                    <TextBlock Text="ПАНЕЛИ И ИНСТРУМЕНТЫ"
                              Style="{StaticResource MenuSectionStyle}"/>

                    <!-- Left Panel -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ToggleLeftPanelCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource PanelLeftIconGeometry}"
                                  Fill="{Binding ShowLeftPanel, Converter={StaticResource BoolToGoldConverter}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Палитра слоёв (слева)"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Path Grid.Column="2"
                                  Data="{StaticResource CheckIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Visibility="{Binding ShowLeftPanel, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>

                    <!-- Right Panel -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ToggleRightPanelCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource PanelRightIconGeometry}"
                                  Fill="{Binding ShowRightPanel, Converter={StaticResource BoolToGoldConverter}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Свойства слоя (справа)"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Path Grid.Column="2"
                                  Data="{StaticResource CheckIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Visibility="{Binding ShowRightPanel, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>

                    <!-- Output Console -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ToggleOutputConsoleCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource TerminalIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Консоль вывода"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Border Grid.Column="2"
                                    Width="16" Height="16"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="Transparent">
                                <Path Data="{StaticResource CheckIconGeometry}"
                                      Fill="{StaticResource Gold400Brush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Visibility="{Binding ShowOutputConsole, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Grid -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ToggleGridCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource Grid3x3IconGeometry}"
                                  Fill="{Binding ShowGrid, Converter={StaticResource BoolToGoldConverter}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Сетка холста"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Path Grid.Column="2"
                                  Data="{StaticResource CheckIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource White5Brush}" Margin="0,16"/>

                    <!-- Section 3: Theme -->
                    <TextBlock Text="ТЕМЫ ОФОРМЛЕНИЯ"
                              Style="{StaticResource MenuSectionStyle}"/>

                    <!-- Dark Theme -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding SelectDarkThemeCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource MoonIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Тёмная тема"
                                      Foreground="White"
                                      FontSize="13"
                                      FontWeight="{Binding CurrentTheme, Converter={StaticResource StringToFontWeightConverter}, ConverterParameter=Dark}"/>

                            <Ellipse Grid.Column="2"
                                    Width="12" Height="12"
                                    Fill="{StaticResource Gold400Brush}"
                                    Visibility="{Binding CurrentTheme, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Dark}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10"
                                                    Opacity="0.5"
                                                    ShadowDepth="0"
                                                    Color="{StaticResource Gold400}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Button>

                    <!-- Light Theme -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding SelectLightThemeCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource SunIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Светлая тема"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>
                        </Grid>
                    </Button>

                    <!-- High Contrast -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding SelectHighContrastCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource AccessibilityIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Высокая контрастность"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>
                        </Grid>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="{StaticResource White5Brush}" Margin="0,16"/>

                    <!-- Section 4: Canvas Options -->
                    <TextBlock Text="ХОЛСТ И РЕДАКТОР"
                              Style="{StaticResource MenuSectionStyle}"/>

                    <!-- Show Coordinates -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ToggleCoordinatesCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource MousePointer2IconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Показывать координаты"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Border Grid.Column="2"
                                    Width="16" Height="16"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="Transparent">
                                <Path Data="{StaticResource CheckIconGeometry}"
                                      Fill="{StaticResource Gold400Brush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Visibility="{Binding ShowCoordinates, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Show Rulers -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ToggleRulersCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource RulerIconGeometry}"
                                  Fill="{StaticResource White30Brush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Линейки"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Border Grid.Column="2"
                                    Width="16" Height="16"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="Transparent">
                                <Path Data="{StaticResource CheckIconGeometry}"
                                      Fill="{StaticResource Gold400Brush}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Snap to Grid -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ToggleSnapToGridCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource MagnetIconGeometry}"
                                  Fill="{Binding SnapToGrid, Converter={StaticResource BoolToGoldConverter}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Привязка к сетке"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Path Grid.Column="2"
                                  Data="{StaticResource CheckIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Visibility="{Binding SnapToGrid, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>

                    <!-- Show Connections -->
                    <Button Style="{StaticResource MenuItemStyle}"
                            Command="{Binding ToggleConnectionsCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource GitCommitIconGeometry}"
                                  Fill="{Binding ShowConnections, Converter={StaticResource BoolToGoldConverter}}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="Отображать связи"
                                      Foreground="{StaticResource White80Brush}"
                                      FontSize="13"/>

                            <Path Grid.Column="2"
                                  Data="{StaticResource CheckIconGeometry}"
                                  Fill="{StaticResource Gold400Brush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Visibility="{Binding ShowConnections, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer with Actions -->
            <Border Grid.Row="2"
                    Background="{StaticResource Coal900Brush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource TextButtonStyle}"
                            Command="{Binding ResetAllCommand}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Сбросить всё"
                                  Foreground="{StaticResource White30Brush}"
                                  FontSize="11"
                                  FontWeight="Bold"/>
                    </Button>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,8,0"
                            Height="36"
                            Padding="20,0">
                        <TextBlock Text="Отмена"
                                  Foreground="{StaticResource White70Brush}"
                                  FontSize="12"/>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ApplyCommand}"
                            Height="36"
                            Padding="24,0">
                        <TextBlock Text="Применить"
                                  Foreground="{StaticResource Coal950Brush}"
                                  FontSize="12"
                                  FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>