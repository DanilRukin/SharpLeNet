<Window x:Class="SharpLeNet.Vision.Wpf.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SharpLeNet.Vision.Wpf.Views.Windows"
        xmlns:controls="clr-namespace:SharpLeNet.Vision.Wpf.Views.Controls"
        xmlns:viewModels="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels"
        Title="SharpLeNet Vision"
        Width="1440" Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource CustomWindowStyle}">

    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Ribbon -->
            <RowDefinition Height="*"/>
            <!-- Main Content -->
            <RowDefinition Height="58"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Ribbon -->
        <Border Grid.Row="0" 
                Style="{StaticResource RibbonStyle}">
            <controls:RibbonView DataContext="{Binding Ribbon}"/>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <!-- Left Palette -->
                <ColumnDefinition Width="*"/>
                <!-- Workspace -->
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <!-- Right Properties -->
            </Grid.ColumnDefinitions>

            <!-- Left Palette -->
            <Border Grid.Column="0" 
                    Style="{StaticResource SidePanelStyle}"
                    Margin="5, 5, 0, 0">
                <controls:LayerPaletteView DataContext="{Binding LayerPalette}"/>
            </Border>
            <GridSplitter Grid.Column="1" 
                          Width="1" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
            <!-- Center Workspace with Tabs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Tabs Header -->
                    <RowDefinition Height="*"/>
                    <!-- Canvas -->
                </Grid.RowDefinitions>

                <!-- Tabs -->
                <Border Grid.Row="0" Style="{StaticResource TabsHeaderStyle}">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Name}"
                                           IsChecked="{Binding IsActive}"
                                           Style="{StaticResource TabItemStyle}"
                                           GroupName="MainTabs"
                                           Command="{Binding DataContext.NavigateToTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ContentControl Grid.Row="1" 
                    Content="{Binding SelectedTab}"
                    Margin="0">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type viewModels:ArchitectureViewModel}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Background="Transparent">
                                <controls:ArchitectureCanvas DataContext="{Binding}"
                                                Width="2000" 
                                                Height="1500"/>
                            </ScrollViewer>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type viewModels:TrainingViewModel}">
                            <controls:TrainingView DataContext="{Binding}"/>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type viewModels:AnalysisViewModel}">
                            <Border Background="{StaticResource Coal800Brush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Margin="24">
                                <TextBlock Text="Analysis Tab - Coming Soon" 
                              Foreground="{StaticResource White60Brush}"
                              FontSize="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type viewModels:PlaygroundViewModel}">
                            <Border Background="{StaticResource Coal800Brush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Margin="24">
                                <TextBlock Text="Playground Tab - Coming Soon" 
                              Foreground="{StaticResource White60Brush}"
                              FontSize="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>

            <GridSplitter Grid.Column="3" 
              Width="1" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
            <!-- Right Properties -->
            <Border Grid.Column="4" 
                    Style="{StaticResource SidePanelStyle}">
                <controls:PropertiesView DataContext="{Binding Properties}"/>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Style="{StaticResource StatusBarStyle}">
            <controls:StatusBarView DataContext="{Binding StatusBar}"/>
        </Border>
    </Grid>

</Window>
