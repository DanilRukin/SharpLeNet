<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Controls.PropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SharpLeNet.Vision.Wpf.Views.Controls"
             xmlns:converters="clr-namespace:SharpLeNet.Vision.Wpf.Converters"
             xmlns:viewModels="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="280"
             d:DataContext="{d:DesignInstance viewModels:PropertiesViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>

        <!-- Стиль для заголовка секции -->
        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource White5Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Стиль для группы свойств -->
        <Style x:Key="PropertyGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Black5Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Стиль для поля ввода - ИСПРАВЛЕННЫЙ -->
        <Style x:Key="PropertyInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Black20Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                            <!-- Фиксированное значение вместо TemplateBinding -->
                            <ScrollViewer x:Name="PART_ContentHost" 
                                  Margin="{TemplateBinding Padding}"
                                  Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Black30Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для комбобокса -->
        <Style x:Key="PropertyComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Black20Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Стиль для числового поля со счетчиком -->
        <Style x:Key="NumericUpDownStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Black20Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Стиль для метки свойства -->
        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource White60Brush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Стиль для значения статистики -->
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- Стиль для метки статистики -->
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource White45Brush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Стиль для карточки статистики -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Black10Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- Шаблон для отображения гистограммы -->
        <DataTemplate x:Key="HistogramTemplate">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Генерация 10 столбцов гистограммы -->
                <Border Grid.Column="0" Background="{StaticResource GoldBrush}" Opacity="0.3" Height="{Binding [0], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
                <Border Grid.Column="1" Background="{StaticResource GoldBrush}" Opacity="0.4" Height="{Binding [1], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
                <Border Grid.Column="2" Background="{StaticResource GoldBrush}" Opacity="0.5" Height="{Binding [2], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
                <Border Grid.Column="3" Background="{StaticResource GoldBrush}" Opacity="0.6" Height="{Binding [3], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
                <Border Grid.Column="4" Background="{StaticResource GoldBrush}" Opacity="0.7" Height="{Binding [4], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
                <Border Grid.Column="5" Background="{StaticResource GoldBrush}" Opacity="0.8" Height="{Binding [5], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
                <Border Grid.Column="6" Background="{StaticResource GoldBrush}" Opacity="0.9" Height="{Binding [6], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
                <Border Grid.Column="7" Background="{StaticResource GoldBrush}" Opacity="0.8" Height="{Binding [7], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
                <Border Grid.Column="8" Background="{StaticResource GoldBrush}" Opacity="0.6" Height="{Binding [8], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
                <Border Grid.Column="9" Background="{StaticResource GoldBrush}" Opacity="0.4" Height="{Binding [9], Converter={StaticResource DoubleToPercentageConverter}, ConverterParameter=40}" VerticalAlignment="Bottom" Margin="1"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SectionHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Свойства слоя" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="16"/>
                    <TextBlock Text="{Binding LayerType, StringFormat='Выбран: {0}'}" 
                               Foreground="{StaticResource White55Brush}" 
                               FontSize="11"
                               FontFamily="Consolas"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="32" Height="32"
                        Style="{StaticResource SquareIconButtonStyle}"
                        Tag="{StaticResource RefreshIcon}"
                        Command="{Binding RefreshStatsCommand}"
                        ToolTip="Обновить статистику"/>
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,0,16,16">

            <StackPanel>
                <!-- No layer selected -->
                <Border Style="{StaticResource PropertyGroupStyle}"
                        Visibility="{Binding SelectedLayer, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="Слой не выбран"
                               Foreground="{StaticResource White45Brush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="20"/>
                </Border>

                <!-- Layer properties (only visible when layer selected) -->
                <StackPanel Visibility="{Binding SelectedLayer, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">

                    <!-- Conv2D Properties -->
                    <Border Style="{StaticResource PropertyGroupStyle}"
                            Visibility="{Binding IsConvLayer, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Сверточный слой" 
                                       Style="{StaticResource PropertyLabelStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldBrush}"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Kernel size -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Kernel" Style="{StaticResource PropertyLabelStyle}" Margin="0,0,4,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Stride" Style="{StaticResource PropertyLabelStyle}" Margin="4,0,0,4"/>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource NumericUpDownStyle}" Margin="0,0,2,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" 
                                                 Text="{Binding KernelSize}"
                                                 Style="{StaticResource PropertyInputStyle}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="8,6"/>
                                        <TextBlock Grid.Column="1" Text="px" Foreground="{StaticResource White45Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource NumericUpDownStyle}" Margin="2,0,0,0">
                                    <TextBox Text="{Binding Stride}"
                                             Style="{StaticResource PropertyInputStyle}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="8,6"/>
                                </Border>

                                <!-- Padding and Filters -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Padding" Style="{StaticResource PropertyLabelStyle}" Margin="0,8,4,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Filters" Style="{StaticResource PropertyLabelStyle}" Margin="4,8,0,4"/>

                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource NumericUpDownStyle}" Margin="0,0,2,0">
                                    <TextBox Text="{Binding Padding}"
                                             Style="{StaticResource PropertyInputStyle}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="8,6"/>
                                </Border>

                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericUpDownStyle}" Margin="2,0,0,0">
                                    <TextBox Text="{Binding Filters}"
                                             Style="{StaticResource PropertyInputStyle}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="8,6"/>
                                </Border>
                            </Grid>

                            <!-- Padding mode -->
                            <TextBlock Text="Padding mode" Style="{StaticResource PropertyLabelStyle}" Margin="0,8,0,4"/>
                            <ComboBox ItemsSource="{Binding PaddingModes}"
                                      SelectedItem="{Binding PaddingMode}"
                                      Style="{StaticResource PropertyComboStyle}"/>

                            <!-- Activation -->
                            <TextBlock Text="Activation" Style="{StaticResource PropertyLabelStyle}" Margin="0,8,0,4"/>
                            <ComboBox ItemsSource="{Binding ActivationFunctions}"
                                      SelectedItem="{Binding SelectedActivation}"
                                      Style="{StaticResource PropertyComboStyle}"/>

                            <!-- Use bias -->
                            <CheckBox Content="Use bias" 
                                      IsChecked="{Binding UseBias}"
                                      Foreground="{StaticResource White80Brush}"
                                      Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Linear Layer Properties -->
                    <Border Style="{StaticResource PropertyGroupStyle}"
                            Visibility="{Binding IsLinearLayer, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Полносвязный слой" 
                                       Style="{StaticResource PropertyLabelStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource LinearOrange}"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Output units" Style="{StaticResource PropertyLabelStyle}" Margin="0,0,4,4"/>
                                <TextBlock Grid.Column="1" Text="Activation" Style="{StaticResource PropertyLabelStyle}" Margin="4,0,0,4"/>

                                <Border Grid.Column="0" Style="{StaticResource NumericUpDownStyle}" Margin="0,0,2,0">
                                    <TextBox Text="{Binding OutputUnits}"
                                             Style="{StaticResource PropertyInputStyle}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="8,6"/>
                                </Border>

                                <ComboBox Grid.Column="1" 
                                          ItemsSource="{Binding ActivationFunctions}"
                                          SelectedItem="{Binding SelectedActivation}"
                                          Style="{StaticResource PropertyComboStyle}"
                                          Margin="2,0,0,0"/>
                            </Grid>

                            <CheckBox Content="Use bias" 
                                      IsChecked="{Binding UseBias}"
                                      Foreground="{StaticResource White80Brush}"
                                      Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Pooling Layer Properties -->
                    <Border Style="{StaticResource PropertyGroupStyle}"
                            Visibility="{Binding IsPoolingLayer, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Пулинг слой" 
                                       Style="{StaticResource PropertyLabelStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PoolGreen}"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Kernel" Style="{StaticResource PropertyLabelStyle}" Margin="0,0,4,4"/>
                                <TextBlock Grid.Column="1" Text="Stride" Style="{StaticResource PropertyLabelStyle}" Margin="4,0,0,4"/>

                                <Border Grid.Column="0" Style="{StaticResource NumericUpDownStyle}" Margin="0,0,2,0">
                                    <TextBox Text="{Binding KernelSize}"
                                             Style="{StaticResource PropertyInputStyle}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="8,6"/>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource NumericUpDownStyle}" Margin="2,0,0,0">
                                    <TextBox Text="{Binding Stride}"
                                             Style="{StaticResource PropertyInputStyle}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="8,6"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Activation Layer Properties -->
                    <Border Style="{StaticResource PropertyGroupStyle}"
                            Visibility="{Binding IsActivationLayer, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Функция активации" 
                                       Style="{StaticResource PropertyLabelStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ActivationPurple}"/>

                            <ComboBox ItemsSource="{Binding ActivationFunctions}"
                                      SelectedItem="{Binding SelectedActivation}"
                                      Style="{StaticResource PropertyComboStyle}"
                                      Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Dropout Layer Properties -->
                    <Border Style="{StaticResource PropertyGroupStyle}"
                            Visibility="{Binding IsDropoutLayer, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Dropout слой" 
                                       Style="{StaticResource PropertyLabelStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource White70Brush}"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Dropout rate" Style="{StaticResource PropertyLabelStyle}" Margin="0,0,8,4"/>

                                <Border Grid.Column="1" Style="{StaticResource NumericUpDownStyle}" Width="80">
                                    <TextBox Text="{Binding DropoutRate, Converter={StaticResource DoubleToPercentageConverter}}"
                                             Style="{StaticResource PropertyInputStyle}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="8,6"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Statistics Cards -->
                    <Border Style="{StaticResource PropertyGroupStyle}">
                        <StackPanel>
                            <TextBlock Text="Статистика" 
                                       Style="{StaticResource PropertyLabelStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Parameters -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="Params" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding ParameterCount, StringFormat='{}{0:N0}'}" 
                                                   Style="{StaticResource StatValueStyle}"
                                                   FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <!-- FLOPs -->
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="FLOPs" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding Flops, Converter={StaticResource FlopsToStringConverter}}" 
                                                   Style="{StaticResource StatValueStyle}"
                                                   FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <!-- Output shape -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,4,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Output" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding OutputShape}" 
                                                   Style="{StaticResource StatValueStyle}"
                                                   FontSize="14"
                                                   FontFamily="Consolas"/>
                                    </StackPanel>
                                </Border>

                                <!-- Memory -->
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="4,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Memory" Style="{StaticResource StatLabelStyle}"/>
                                        <TextBlock Text="{Binding MemoryUsage, Converter={StaticResource MemoryToStringConverter}}" 
                                                   Style="{StaticResource StatValueStyle}"
                                                   FontSize="14"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Weight Distribution -->
                    <Border Style="{StaticResource PropertyGroupStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="Распределение весов" 
                                           Style="{StaticResource PropertyLabelStyle}"
                                           FontWeight="SemiBold"/>

                                <TextBlock Grid.Column="1" 
                                           Text="min          max" 
                                           Foreground="{StaticResource White45Brush}"
                                           FontSize="9"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Histogram -->
                            <ContentControl Content="{Binding WeightDistribution}"
                                          ContentTemplate="{StaticResource HistogramTemplate}"
                                          Margin="0,8,0,4"/>

                            <!-- Min/Max labels -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="-0.3" Foreground="{StaticResource White45Brush}" FontSize="9" FontFamily="Consolas"/>
                                <TextBlock Grid.Column="1" Text="0" Foreground="{StaticResource White45Brush}" FontSize="9" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="0.5" Foreground="{StaticResource White45Brush}" FontSize="9" FontFamily="Consolas" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Применить"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding ApplyCommand}"
                                Margin="0,0,4,0"
                                Height="36"/>

                        <Button Grid.Column="1" 
                                Content="Сброс"
                                Style="{StaticResource OutlinedButtonStyle}"
                                Command="{Binding ResetCommand}"
                                Margin="4,0,0,0"
                                Height="36"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>