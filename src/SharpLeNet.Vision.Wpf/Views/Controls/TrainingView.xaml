<!-- Views/TrainingView.xaml -->
<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Controls.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels"
             xmlns:converters="clr-namespace:SharpLeNet.Vision.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance viewModels:TrainingViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <converters:DoubleToPercentageConverter x:Key="DoubleToPercentageConverter"/>

        <!-- Стиль для кнопок управления -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource PanelSoftShadow}"/>
        </Style>

        <!-- Стиль для карточек метрик -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Coal800Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource PanelSoftShadow}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel Margin="24">
            <!-- Заголовок -->
            <TextBlock Text="Training Dashboard" 
                       Foreground="White" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <!-- Разделитель -->
            <Rectangle Height="1" 
                       Fill="{StaticResource BorderLightBrush}" 
                       Margin="0,0,0,24"/>

            <!-- ========== СЕКЦИЯ 1: ПАНЕЛЬ УПРАВЛЕНИЯ ========== -->
            <Border Background="{StaticResource Coal800Brush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    Effect="{StaticResource PanelSoftShadow}"
                    Margin="0,0,0,24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Кнопки -->
                        <ColumnDefinition Width="*"/>
                        <!-- Параметры -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Статус -->
                    </Grid.ColumnDefinitions>

                    <!-- Кнопки управления -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Resume/Start Training -->
                        <Button Command="{Binding StartCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                Background="{StaticResource GoldGradientBrush}"
                                BorderBrush="{StaticResource GoldBrush}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8,4 L20,12 L8,20 Z" 
                                      Fill="#141414"
                                      Width="16" Height="16"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Resume Training" 
                                         Foreground="#141414"/>
                            </StackPanel>
                        </Button>

                        <!-- Pause -->
                        <Button Command="{Binding PauseCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                Background="{StaticResource White5Brush}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="14" 
                                          Fill="{StaticResource White70Brush}"
                                          Margin="0,0,8,0"/>
                                <TextBlock Text="Pause" 
                                         Foreground="{StaticResource White80Brush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop -->
                        <Button Command="{Binding StopCommand}"
                                Style="{StaticResource OutlinedButtonStyle}"
                                Background="#2d1a1a"
                                BorderBrush="#f8717150"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" 
                                          Fill="#f87171"
                                          Margin="0,0,8,0"/>
                                <TextBlock Text="Stop" 
                                         Foreground="#f87171"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Параметры обучения (Learning Rate, Batch Size, Epochs) -->
                    <Grid Grid.Column="1" Margin="40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- Learning Rate Slider -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                          Text="Learning Rate" 
                                          Foreground="{StaticResource White50Brush}" 
                                          FontSize="10"/>
                                <TextBlock Grid.Column="1" 
                                          Text="{Binding LearningRateDisplay}" 
                                          Foreground="{StaticResource GoldBrush}" 
                                          FontFamily="Consolas"
                                          FontSize="10"/>
                            </Grid>
                            <Slider Minimum="0.0001" 
                                    Maximum="0.01" 
                                    Value="{Binding LearningRate}"
                                    TickFrequency="0.0001"
                                    IsSnapToTickEnabled="True"
                                    Width="200"
                                    Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Разделитель -->
                        <Rectangle Grid.Column="1" 
                                   Width="1" 
                                   Fill="{StaticResource BorderLightBrush}" 
                                   Margin="0,4"/>

                        <!-- Batch Size -->
                        <StackPanel Grid.Column="2" Margin="20,0">
                            <TextBlock Text="Batch Size" 
                                      Foreground="{StaticResource White50Brush}" 
                                      FontSize="10"
                                      Margin="0,0,0,4"/>

                            <TextBox Text="{Binding TotalBatches}" 
                                     Background="{StaticResource Coal900Brush}"
                                     BorderBrush="{StaticResource BorderLightBrush}"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     FontFamily="Consolas"
                                     Foreground="White"
                                     Width="80"/>
                        </StackPanel>

                        <!-- Max Epochs -->
                        <StackPanel Grid.Column="3" Margin="0,0,0,0">
                            <TextBlock Text="Max Epochs" 
                                      Foreground="{StaticResource White50Brush}" 
                                      FontSize="10"
                                      Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TotalEpochs}" 
                                     Background="{StaticResource Coal900Brush}"
                                     BorderBrush="{StaticResource BorderLightBrush}"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     FontFamily="Consolas"
                                     Foreground="White"
                                     Width="80"/>
                        </StackPanel>
                    </Grid>

                    <!-- Статус -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                            <TextBlock Text="Status" 
                                      Foreground="{StaticResource White40Brush}" 
                                      FontSize="10"
                                      HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8"
                                        Fill="{Binding IsTraining, Converter={StaticResource BoolToColorConverter}}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Status}" 
                                         Foreground="{Binding IsTraining, Converter={StaticResource BoolToStatusColorConverter}}"
                                         FontWeight="SemiBold"
                                         FontSize="14"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Refresh button -->
                        <Button Width="40" Height="40"
                                Style="{StaticResource SquareIconButtonStyle}"
                                Tag="{StaticResource RefreshIcon}"
                                Command="{Binding RefreshCommand}">
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== СЕКЦИЯ 2: ГРАФИКИ LOSS И ACCURACY ========== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- График Loss -->
                <Border Grid.Column="0"
            Background="{StaticResource Coal800Brush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Effect="{StaticResource PanelSoftShadow}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок и легенда -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Loss Curve" 
                              Foreground="White" 
                              FontSize="16" 
                              FontWeight="SemiBold"/>
                                <TextBlock Text="Cross Entropy per Epoch" 
                              Foreground="{StaticResource White40Brush}" 
                              FontSize="11"/>
                            </StackPanel>

                            <!-- Легенда -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Rectangle Width="12" Height="3" 
                                  Fill="{StaticResource GoldBrush}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                                    <TextBlock Text="Train" 
                                  Foreground="{StaticResource GoldBrush}"
                                  FontSize="10"
                                  FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="12" Height="3" 
                                  Fill="{StaticResource CyanBrush}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  StrokeDashArray="2,2"/>
                                    <TextBlock Text="Validation" 
                                  Foreground="{StaticResource CyanBrush}"
                                  FontSize="10"
                                  FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- График с сеткой -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Значения по оси Y (слева) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" 
                           VerticalAlignment="Stretch" 
                           HorizontalAlignment="Right"
                           Margin="0,0,5,0">
                                <TextBlock Text="1.0" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                                <TextBlock Text="0.5" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                                <TextBlock Text="0.0" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                            </StackPanel>

                            <!-- Область графика -->
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Горизонтальные линии сетки -->
                                <Rectangle Grid.Row="0" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>
                                <Rectangle Grid.Row="1" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>
                                <Rectangle Grid.Row="2" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>

                                <!-- Вертикальные линии сетки -->
                                <Rectangle Grid.Column="1" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="2" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="3" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="4" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>

                                <!-- Линии графика -->
                                <Polyline Grid.RowSpan="4" Grid.ColumnSpan="5"
                             Points="{Binding TrainLossPoints, Converter={StaticResource DataPointsToPointCollectionConverter}}"
                             Stroke="{StaticResource GoldBrush}"
                             StrokeThickness="2"
                             StrokeLineJoin="Round"
                             Stretch="Fill"/>

                                <Polyline Grid.RowSpan="4" Grid.ColumnSpan="5"
                             Points="{Binding ValLossPoints, Converter={StaticResource DataPointsToPointCollectionConverter}}"
                             Stroke="{StaticResource CyanBrush}"
                             StrokeThickness="2"
                             StrokeDashArray="4,2"
                             StrokeLineJoin="Round"
                             Stretch="Fill"/>
                            </Grid>

                            <!-- Подписи по оси X -->
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                              Text="Epoch 0" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"/>
                                <TextBlock Grid.Column="2" 
                              Text="5" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" 
                              Text="15" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Разделитель -->
                <Grid Grid.Column="1"/>

                <!-- График Accuracy (аналогичная структура) -->
                <Border Grid.Column="2"
            Background="{StaticResource Coal800Brush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Effect="{StaticResource PanelSoftShadow}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок и легенда -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Accuracy" 
                              Foreground="White" 
                              FontSize="16" 
                              FontWeight="SemiBold"/>
                                <TextBlock Text="Categorical Acc %" 
                              Foreground="{StaticResource White40Brush}" 
                              FontSize="11"/>
                            </StackPanel>

                            <!-- Легенда -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Rectangle Width="12" Height="3" 
                                  Fill="{StaticResource GoldBrush}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                                    <TextBlock Text="Train" 
                                  Foreground="{StaticResource GoldBrush}"
                                  FontSize="10"
                                  FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="12" Height="3" 
                                  Fill="{StaticResource CyanBrush}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  StrokeDashArray="2,2"/>
                                    <TextBlock Text="Validation" 
                                  Foreground="{StaticResource CyanBrush}"
                                  FontSize="10"
                                  FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- График с сеткой -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Значения по оси Y (слева) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" 
                           VerticalAlignment="Stretch" 
                           HorizontalAlignment="Right"
                           Margin="0,0,5,0">
                                <TextBlock Text="100%" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                                <TextBlock Text="50%" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                                <TextBlock Text="0%" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                            </StackPanel>

                            <!-- Область графика -->
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Горизонтальные линии сетки -->
                                <Rectangle Grid.Row="0" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>
                                <Rectangle Grid.Row="1" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>
                                <Rectangle Grid.Row="2" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>

                                <!-- Вертикальные линии сетки -->
                                <Rectangle Grid.Column="1" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="2" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="3" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="4" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>

                                <!-- Линии графика -->
                                <Polyline Grid.RowSpan="4" Grid.ColumnSpan="5"
                             Points="{Binding TrainAccPoints, Converter={StaticResource DataPointsToPointCollectionConverter}}"
                             Stroke="{StaticResource GoldBrush}"
                             StrokeThickness="2"
                             StrokeLineJoin="Round"
                             Stretch="Fill"/>

                                <Polyline Grid.RowSpan="4" Grid.ColumnSpan="5"
                             Points="{Binding ValAccPoints, Converter={StaticResource DataPointsToPointCollectionConverter}}"
                             Stroke="{StaticResource CyanBrush}"
                             StrokeThickness="2"
                             StrokeDashArray="4,2"
                             StrokeLineJoin="Round"
                             Stretch="Fill"/>
                            </Grid>

                            <!-- Подписи по оси X -->
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                              Text="Epoch 0" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"/>
                                <TextBlock Grid.Column="2" 
                              Text="5" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" 
                              Text="15" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Временное содержимое для проверки (оставим пока) -->
            <Border Background="{StaticResource Coal800Brush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32"
                    Effect="{StaticResource PanelSoftShadow}">
                <StackPanel>
                    <TextBlock Text="TRAINING TAB IS WORKING!" 
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Данные тренировки будут здесь" 
                               Foreground="{StaticResource White60Brush}"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>

                    <Grid Margin="0,32,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Current Epoch" 
                                      Foreground="{StaticResource White60Brush}"
                                      FontSize="12"/>
                            <TextBlock Text="{Binding EpochDisplay}" 
                                      Foreground="White"
                                      FontSize="24"
                                      FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Current Loss" 
                                      Foreground="{StaticResource White60Brush}"
                                      FontSize="12"/>
                            <TextBlock Text="{Binding CurrentLossDisplay}" 
                                      Foreground="White"
                                      FontSize="24"
                                      FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>