<!-- Views/TrainingView.xaml -->
<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Controls.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels"
             xmlns:converters="clr-namespace:SharpLeNet.Vision.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance viewModels:TrainingViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <converters:DoubleToPercentageConverter x:Key="DoubleToPercentageConverter"/>

        <!-- Стиль для кнопок управления -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource PanelSoftShadow}"/>
        </Style>

        <!-- Стиль для карточек метрик -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Coal800Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource PanelSoftShadow}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel Margin="24">
            <!-- Заголовок -->
            <TextBlock Text="Training Dashboard" 
                       Foreground="White" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <!-- Разделитель -->
            <Rectangle Height="1" 
                       Fill="{StaticResource BorderLightBrush}" 
                       Margin="0,0,0,24"/>

            <!-- ========== СЕКЦИЯ 1: ПАНЕЛЬ УПРАВЛЕНИЯ ========== -->
            <Border Background="{StaticResource Coal800Brush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    Effect="{StaticResource PanelSoftShadow}"
                    Margin="0,0,0,24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Кнопки -->
                        <ColumnDefinition Width="*"/>
                        <!-- Параметры -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Статус -->
                    </Grid.ColumnDefinitions>

                    <!-- Кнопки управления -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Resume/Start Training -->
                        <Button Command="{Binding StartCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                Background="{StaticResource GoldGradientBrush}"
                                BorderBrush="{StaticResource GoldBrush}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8,4 L20,12 L8,20 Z" 
                                      Fill="#141414"
                                      Width="16" Height="16"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="Resume Training" 
                                         Foreground="#141414"/>
                            </StackPanel>
                        </Button>

                        <!-- Pause -->
                        <Button Command="{Binding PauseCommand}"
                                Style="{StaticResource TextButtonStyle}"
                                Background="{StaticResource White5Brush}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="14" 
                                          Fill="{StaticResource White70Brush}"
                                          Margin="0,0,8,0"/>
                                <TextBlock Text="Pause" 
                                         Foreground="{StaticResource White80Brush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop -->
                        <Button Command="{Binding StopCommand}"
                                Style="{StaticResource OutlinedButtonStyle}"
                                Background="#2d1a1a"
                                BorderBrush="#f8717150"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" 
                                          Fill="#f87171"
                                          Margin="0,0,8,0"/>
                                <TextBlock Text="Stop" 
                                         Foreground="#f87171"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Параметры обучения (Learning Rate, Batch Size, Epochs) -->
                    <Grid Grid.Column="1" Margin="40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- Learning Rate Slider -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                          Text="Learning Rate" 
                                          Foreground="{StaticResource White50Brush}" 
                                          FontSize="10"/>
                                <TextBlock Grid.Column="1" 
                                          Text="{Binding LearningRateDisplay}" 
                                          Foreground="{StaticResource GoldBrush}" 
                                          FontFamily="Consolas"
                                          FontSize="10"/>
                            </Grid>
                            <Slider Minimum="0.0001" 
                                    Maximum="0.01" 
                                    Value="{Binding LearningRate}"
                                    TickFrequency="0.0001"
                                    IsSnapToTickEnabled="True"
                                    Width="200"
                                    Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Разделитель -->
                        <Rectangle Grid.Column="1" 
                                   Width="1" 
                                   Fill="{StaticResource BorderLightBrush}" 
                                   Margin="0,4"/>

                        <!-- Batch Size -->
                        <StackPanel Grid.Column="2" Margin="20,0">
                            <TextBlock Text="Batch Size" 
                                      Foreground="{StaticResource White50Brush}" 
                                      FontSize="10"
                                      Margin="0,0,0,4"/>

                            <TextBox Text="{Binding TotalBatches}" 
                                     Background="{StaticResource Coal900Brush}"
                                     BorderBrush="{StaticResource BorderLightBrush}"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     FontFamily="Consolas"
                                     Foreground="White"
                                     Width="80"/>
                        </StackPanel>

                        <!-- Max Epochs -->
                        <StackPanel Grid.Column="3" Margin="0,0,0,0">
                            <TextBlock Text="Max Epochs" 
                                      Foreground="{StaticResource White50Brush}" 
                                      FontSize="10"
                                      Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TotalEpochs}" 
                                     Background="{StaticResource Coal900Brush}"
                                     BorderBrush="{StaticResource BorderLightBrush}"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     FontFamily="Consolas"
                                     Foreground="White"
                                     Width="80"/>
                        </StackPanel>
                    </Grid>

                    <!-- Статус -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                            <TextBlock Text="Status" 
                                      Foreground="{StaticResource White40Brush}" 
                                      FontSize="10"
                                      HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8"
                                        Fill="{Binding IsTraining, Converter={StaticResource BoolToColorConverter}}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Status}" 
                                         Foreground="{Binding IsTraining, Converter={StaticResource BoolToStatusColorConverter}}"
                                         FontWeight="SemiBold"
                                         FontSize="14"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Refresh button -->
                        <Button Width="40" Height="40"
                                Style="{StaticResource SquareIconButtonStyle}"
                                Tag="{StaticResource RefreshIcon}"
                                Command="{Binding RefreshCommand}">
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== СЕКЦИЯ 2: ГРАФИКИ LOSS И ACCURACY ========== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- График Loss -->
                <Border Grid.Column="0"
            Background="{StaticResource Coal800Brush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Effect="{StaticResource PanelSoftShadow}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок и легенда -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Loss Curve" 
                              Foreground="White" 
                              FontSize="16" 
                              FontWeight="SemiBold"/>
                                <TextBlock Text="Cross Entropy per Epoch" 
                              Foreground="{StaticResource White40Brush}" 
                              FontSize="11"/>
                            </StackPanel>

                            <!-- Легенда -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Rectangle Width="12" Height="3" 
                                  Fill="{StaticResource GoldBrush}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                                    <TextBlock Text="Train" 
                                  Foreground="{StaticResource GoldBrush}"
                                  FontSize="10"
                                  FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="12" Height="3" 
                                  Fill="{StaticResource CyanBrush}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  StrokeDashArray="2,2"/>
                                    <TextBlock Text="Validation" 
                                  Foreground="{StaticResource CyanBrush}"
                                  FontSize="10"
                                  FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- График с сеткой -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Значения по оси Y (слева) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" 
                           VerticalAlignment="Stretch" 
                           HorizontalAlignment="Right"
                           Margin="0,0,5,0">
                                <TextBlock Text="1.0" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                                <TextBlock Text="0.5" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                                <TextBlock Text="0.0" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                            </StackPanel>

                            <!-- Область графика -->
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Горизонтальные линии сетки -->
                                <Rectangle Grid.Row="0" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>
                                <Rectangle Grid.Row="1" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>
                                <Rectangle Grid.Row="2" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>

                                <!-- Вертикальные линии сетки -->
                                <Rectangle Grid.Column="1" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="2" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="3" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="4" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>

                                <!-- Линии графика -->
                                <Polyline Grid.RowSpan="4" Grid.ColumnSpan="5"
                             Points="{Binding TrainLossPoints, Converter={StaticResource DataPointsToPointCollectionConverter}}"
                             Stroke="{StaticResource GoldBrush}"
                             StrokeThickness="2"
                             StrokeLineJoin="Round"
                             Stretch="Fill"/>

                                <Polyline Grid.RowSpan="4" Grid.ColumnSpan="5"
                             Points="{Binding ValLossPoints, Converter={StaticResource DataPointsToPointCollectionConverter}}"
                             Stroke="{StaticResource CyanBrush}"
                             StrokeThickness="2"
                             StrokeDashArray="4,2"
                             StrokeLineJoin="Round"
                             Stretch="Fill"/>
                            </Grid>

                            <!-- Подписи по оси X -->
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                              Text="Epoch 0" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"/>
                                <TextBlock Grid.Column="2" 
                              Text="5" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" 
                              Text="15" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Разделитель -->
                <Grid Grid.Column="1"/>

                <!-- График Accuracy (аналогичная структура) -->
                <Border Grid.Column="2"
            Background="{StaticResource Coal800Brush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Effect="{StaticResource PanelSoftShadow}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок и легенда -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Accuracy" 
                              Foreground="White" 
                              FontSize="16" 
                              FontWeight="SemiBold"/>
                                <TextBlock Text="Categorical Acc %" 
                              Foreground="{StaticResource White40Brush}" 
                              FontSize="11"/>
                            </StackPanel>

                            <!-- Легенда -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Rectangle Width="12" Height="3" 
                                  Fill="{StaticResource GoldBrush}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                                    <TextBlock Text="Train" 
                                  Foreground="{StaticResource GoldBrush}"
                                  FontSize="10"
                                  FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="12" Height="3" 
                                  Fill="{StaticResource CyanBrush}"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  StrokeDashArray="2,2"/>
                                    <TextBlock Text="Validation" 
                                  Foreground="{StaticResource CyanBrush}"
                                  FontSize="10"
                                  FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- График с сеткой -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Значения по оси Y (слева) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" 
                           VerticalAlignment="Stretch" 
                           HorizontalAlignment="Right"
                           Margin="0,0,5,0">
                                <TextBlock Text="100%" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                                <TextBlock Text="50%" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                                <TextBlock Text="0%" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              Height="25"/>
                            </StackPanel>

                            <!-- Область графика -->
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Горизонтальные линии сетки -->
                                <Rectangle Grid.Row="0" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>
                                <Rectangle Grid.Row="1" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>
                                <Rectangle Grid.Row="2" Grid.ColumnSpan="5"
                              Height="1" 
                              Fill="{StaticResource White5Brush}"
                              VerticalAlignment="Bottom"/>

                                <!-- Вертикальные линии сетки -->
                                <Rectangle Grid.Column="1" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="2" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="3" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>
                                <Rectangle Grid.Column="4" Grid.RowSpan="4"
                              Width="1" 
                              Fill="{StaticResource White5Brush}"
                              HorizontalAlignment="Left"/>

                                <!-- Линии графика -->
                                <Polyline Grid.RowSpan="4" Grid.ColumnSpan="5"
                             Points="{Binding TrainAccPoints, Converter={StaticResource DataPointsToPointCollectionConverter}}"
                             Stroke="{StaticResource GoldBrush}"
                             StrokeThickness="2"
                             StrokeLineJoin="Round"
                             Stretch="Fill"/>

                                <Polyline Grid.RowSpan="4" Grid.ColumnSpan="5"
                             Points="{Binding ValAccPoints, Converter={StaticResource DataPointsToPointCollectionConverter}}"
                             Stroke="{StaticResource CyanBrush}"
                             StrokeThickness="2"
                             StrokeDashArray="4,2"
                             StrokeLineJoin="Round"
                             Stretch="Fill"/>
                            </Grid>

                            <!-- Подписи по оси X -->
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                              Text="Epoch 0" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"/>
                                <TextBlock Grid.Column="2" 
                              Text="5" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" 
                              Text="15" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              FontFamily="Consolas"
                              HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Views/TrainingView.xaml - СЕКЦИЯ 3: КАРТОЧКИ МЕТРИК (исправленная) -->

            <!-- ========== СЕКЦИЯ 3: КАРТОЧКИ МЕТРИК ========== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Карточка 1: Current Loss -->
                <Border Grid.Column="0"
            Style="{StaticResource MetricCardStyle}"
            Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="CURRENT LOSS" 
                      Foreground="{StaticResource White40Brush}" 
                      FontSize="11"
                      FontWeight="Medium"/>

                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                          Text="{Binding CurrentLossDisplay}" 
                          Foreground="White" 
                          FontSize="32" 
                          FontWeight="Bold"/>

                            <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                                <Path Data="M16,4 L4,16 M4,8 L4,16 L12,16" 
                          Stroke="{StaticResource EmeraldBrush}"
                          StrokeThickness="2"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,4,0"/>
                                <TextBlock Text="2.1%" 
                              Foreground="{StaticResource EmeraldBrush}"
                              FontSize="14"
                              FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress bar с правильной шириной через Grid -->
                        <Grid Height="4" Margin="0,4,0,0">
                            <Border Background="{StaticResource White5Brush}"
                        CornerRadius="2"/>
                            <Border Background="{StaticResource GoldBrush}"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        Width="60">
                                <!-- Фиксированная ширина для теста -->
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Карточка 2: Validation Accuracy -->
                <Border Grid.Column="1"
            Style="{StaticResource MetricCardStyle}"
            Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="VALIDATION ACC" 
                      Foreground="{StaticResource White40Brush}" 
                      FontSize="11"
                      FontWeight="Medium"/>

                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                          Text="{Binding ValidationAccuracyDisplay}" 
                          Foreground="White" 
                          FontSize="32" 
                          FontWeight="Bold"/>

                            <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                                <Path Data="M4,4 L16,16 M8,4 L16,4 L16,12" 
                          Stroke="{StaticResource EmeraldBrush}"
                          StrokeThickness="2"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,4,0"/>
                                <TextBlock Text="0.4%" 
                              Foreground="{StaticResource EmeraldBrush}"
                              FontSize="14"
                              FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress bar с правильной шириной через Grid -->
                        <Grid Height="4" Margin="0,4,0,0">
                            <Border Background="{StaticResource White5Brush}"
                        CornerRadius="2"/>
                            <Border Background="{StaticResource CyanBrush}"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        Width="200">
                                <!-- Фиксированная ширина для теста -->
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Карточка 3: Learning Rate -->
                <Border Grid.Column="2"
            Style="{StaticResource MetricCardStyle}"
            Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="LEARNING RATE" 
                      Foreground="{StaticResource White40Brush}" 
                      FontSize="11"
                      FontWeight="Medium"/>

                        <TextBlock Text="{Binding LearningRateDisplay}" 
                      Foreground="White" 
                      FontSize="28" 
                      FontWeight="Bold"
                      FontFamily="Consolas"
                      Margin="0,12,0,8"/>

                        <TextBlock Text="Schedule: Exponential" 
                      Foreground="{StaticResource White30Brush}" 
                      FontSize="10"
                      FontWeight="Medium"/>
                    </StackPanel>
                </Border>

                <!-- Карточка 4: Estimated Time -->
                <Border Grid.Column="3"
            Style="{StaticResource MetricCardStyle}"
            Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ESTIMATED TIME" 
                      Foreground="{StaticResource White40Brush}" 
                      FontSize="11"
                      FontWeight="Medium"/>

                        <TextBlock Text="{Binding EtaDisplay}" 
                      Foreground="White" 
                      FontSize="28" 
                      FontWeight="Bold"
                      FontFamily="Consolas"
                      Margin="0,12,0,8"/>

                        <TextBlock Text="Total: 15 Epochs" 
                      Foreground="{StaticResource White30Brush}" 
                      FontSize="10"
                      FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Views/TrainingView.xaml - добавляем после карточек метрик, перед временным содержимым -->

            <!-- ========== СЕКЦИЯ 4: CONFUSION MATRIX И ТАБЛИЦА ИСТОРИИ ========== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Confusion Matrix -->
                <Border Grid.Column="0"
            Background="{StaticResource Coal800Brush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Effect="{StaticResource PanelSoftShadow}">

                    <StackPanel>
                        <!-- Заголовок -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="M4,4 L20,4 L20,20 L4,20 Z M8,8 L16,8 L16,16 L8,16 Z"
                      Fill="{StaticResource GoldBrush}"
                      Width="20" Height="20"
                      Stretch="Uniform"
                      Margin="0,0,8,0"/>
                            <TextBlock Text="Confusion Matrix (MNIST)" 
                          Foreground="White" 
                          FontSize="16" 
                          FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Контейнер для матрицы -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Подписи осей -->
                            <StackPanel Grid.Row="0" Grid.Column="1" 
                           Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4">
                                <TextBlock Text="Predicted" 
                              Foreground="{StaticResource White40Brush}" 
                              FontSize="9"
                              FontWeight="Medium"
                              Margin="0,0,20,0"/>
                                <TextBlock Text="→" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              Margin="0,0,20,0"/>
                                <ItemsControl ItemsSource="{Binding ConfusionMatrix.ClassLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                          Foreground="{StaticResource White40Brush}" 
                                          FontSize="9"
                                          FontFamily="Consolas"
                                          Width="28"
                                          TextAlignment="Center"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" 
                           VerticalAlignment="Center"
                           Margin="0,0,4,0">
                                <TextBlock Text="Actual" 
                              Foreground="{StaticResource White40Brush}" 
                              FontSize="9"
                              FontWeight="Medium">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                                <TextBlock Text="↓" 
                              Foreground="{StaticResource White30Brush}" 
                              FontSize="9"
                              Margin="0,4,0,4"/>
                                <ItemsControl ItemsSource="{Binding ConfusionMatrix.ClassLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                          Foreground="{StaticResource White40Brush}" 
                                          FontSize="9"
                                          FontFamily="Consolas"
                                          Height="28"
                                          VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Сама матрица -->
                            <ItemsControl Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding ConfusionMatrix.MatrixCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="10" Rows="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Color}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    CornerRadius="2"
                                    Margin="1"
                                    ToolTip="{Binding ToolTip}">
                                            <TextBlock Text="{Binding Value}" 
                                          Foreground="{Binding TextColor}"
                                          FontSize="8"
                                          FontFamily="Consolas"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Дополнительная информация -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                          Text="Overall Accuracy:" 
                          Foreground="{StaticResource White60Brush}" 
                          FontSize="11"/>
                            <TextBlock Grid.Column="1" 
                          Text="{Binding ConfusionMatrix.OverallAccuracyDisplay}" 
                          Foreground="{StaticResource GoldBrush}" 
                          FontSize="11"
                          FontWeight="Bold"
                          Margin="8,0,0,0"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Selected class:" 
                              Foreground="{StaticResource White60Brush}" 
                              FontSize="11"/>
                                <ComboBox ItemsSource="{Binding ConfusionMatrix.ClassLabels}"
                              SelectedItem="{Binding ConfusionMatrix.SelectedClass}"
                              Background="{StaticResource Coal900Brush}"
                              BorderBrush="{StaticResource BorderLightBrush}"
                              Foreground="White"
                              FontSize="11"
                              Width="60"
                              Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Детали для выбранного класса -->
                        <Border Background="{StaticResource White5Brush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TP" 
                                  Foreground="{StaticResource White40Brush}" 
                                  FontSize="9"/>
                                    <TextBlock Text="{Binding ConfusionMatrix.SelectedClassData.TP}" 
                                  Foreground="{StaticResource EmeraldBrush}" 
                                  FontSize="14"
                                  FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FP" 
                                  Foreground="{StaticResource White40Brush}" 
                                  FontSize="9"/>
                                    <TextBlock Text="{Binding ConfusionMatrix.SelectedClassData.FP}" 
                                  Foreground="#f87171" 
                                  FontSize="14"
                                  FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="FN" 
                                  Foreground="{StaticResource White40Brush}" 
                                  FontSize="9"/>
                                    <TextBlock Text="{Binding ConfusionMatrix.SelectedClassData.FN}" 
                                  Foreground="#f87171" 
                                  FontSize="14"
                                  FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="TN" 
                                  Foreground="{StaticResource White40Brush}" 
                                  FontSize="9"/>
                                    <TextBlock Text="{Binding ConfusionMatrix.SelectedClassData.TN}" 
                                  Foreground="{StaticResource EmeraldBrush}" 
                                  FontSize="14"
                                  FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Разделитель -->
                <Grid Grid.Column="1"/>

                <!-- Таблица истории обучения -->
                <Border Grid.Column="2"
            Background="{StaticResource Coal800Brush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0"
            Effect="{StaticResource PanelSoftShadow}">

                    <StackPanel>
                        <!-- Заголовок -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,4 L20,4 L20,20 L4,20 Z M8,8 L16,8 L16,16 L8,16 Z"
                              Fill="{StaticResource GoldBrush}"
                              Width="20" Height="20"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                                    <TextBlock Text="Training History Log" 
                                  Foreground="White" 
                                  FontSize="16" 
                                  FontWeight="SemiBold"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                            Background="{StaticResource White5Brush}"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,4">
                                    <TextBlock Text="Showing last 5 epochs" 
                                  Foreground="{StaticResource White50Brush}" 
                                  FontSize="9"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Таблица -->
                        <ListView ItemsSource="{Binding EpochHistory}"
                      Background="Transparent"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MaxHeight="300">
                            <ListView.View>
                                <GridView>
                                    <!-- Epoch -->
                                    <GridViewColumn Header="Epoch" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Epoch}" 
                                              Foreground="{StaticResource White80Brush}" 
                                              FontFamily="Consolas"
                                              FontSize="11"
                                              Margin="6,4"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Train Loss -->
                                    <GridViewColumn Header="Train Loss" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TrainLossDisplay}" 
                                              Foreground="{StaticResource GoldBrush}" 
                                              FontFamily="Consolas"
                                              FontSize="11"
                                              Margin="6,4"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Val Loss -->
                                    <GridViewColumn Header="Val Loss" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ValLossDisplay}" 
                                              Foreground="{StaticResource CyanBrush}" 
                                              FontFamily="Consolas"
                                              FontSize="11"
                                              Margin="6,4"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Train Acc -->
                                    <GridViewColumn Header="Train Acc" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TrainAccDisplay}" 
                                              Foreground="White" 
                                              FontFamily="Consolas"
                                              FontSize="11"
                                              Margin="6,4"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Val Acc -->
                                    <GridViewColumn Header="Val Acc" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ValAccDisplay}" 
                                              Foreground="White" 
                                              FontFamily="Consolas"
                                              FontWeight="{Binding IsBest, Converter={StaticResource BoolToFontWeightConverter}}"
                                              FontSize="11"
                                              Margin="6,4"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Time -->
                                    <GridViewColumn Header="Time" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Time}" 
                                              Foreground="{StaticResource White50Brush}" 
                                              FontFamily="Consolas"
                                              FontSize="11"
                                              Margin="6,4"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- LR -->
                                    <GridViewColumn Header="LR" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LearningRateDisplay}" 
                                              Foreground="{StaticResource White50Brush}" 
                                              FontFamily="Consolas"
                                              FontSize="11"
                                              Margin="6,4"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource White5Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>