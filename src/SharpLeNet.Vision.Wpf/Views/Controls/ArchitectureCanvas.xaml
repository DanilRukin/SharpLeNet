<!-- Views/Controls/ArchitectureCanvas.xaml -->
<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Controls.ArchitectureCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SharpLeNet.Vision.Wpf.Views.Controls"
             xmlns:viewModels="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels"
             xmlns:behav="clr-namespace:SharpLeNet.Vision.Wpf.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance viewModels:ArchitectureViewModel}">

    <UserControl.Resources>

        <!-- Кисти для соединений -->
        <LinearGradientBrush x:Key="ConnectionGradient1" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#60a5fa" Offset="0.0"/>
            <GradientStop Color="#d4af37" Offset="0.5"/>
            <GradientStop Color="#34d399" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ConnectionGradient2" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#34d399" Offset="0.0"/>
            <GradientStop Color="#ffd700" Offset="0.6"/>
            <GradientStop Color="#fdba74" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Эффект свечения для соединений -->
        <DropShadowEffect x:Key="ConnectionGlow" 
                          BlurRadius="8" 
                          Opacity="0.4" 
                          ShadowDepth="0"
                          Color="#d4af37"/>

        <!-- Стиль для блока слоя -->
        <Style x:Key="LayerBlockStyle" TargetType="local:LayerBlock">
            <Setter Property="Width" Value="210"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Effect" Value="{StaticResource BlockShadow}"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="{Binding Position.X}" Y="{Binding Position.Y}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для соединения -->
        <Style x:Key="ConnectionStyle" TargetType="local:ConnectionLine">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Stroke" Value="{StaticResource ConnectionGradient1}"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="Effect" Value="{StaticResource ConnectionGlow}"/>
        </Style>

        <!-- Шаблон для отображения блоков слоев -->
        <DataTemplate DataType="{x:Type viewModels:LayerBlockViewModel}">
            <local:LayerBlock DataContext="{Binding}" 
                              Style="{StaticResource LayerBlockStyle}"/>
        </DataTemplate>

        <!-- Шаблон для отображения соединений -->
        <DataTemplate DataType="{x:Type viewModels:ConnectionViewModel}">
            <local:ConnectionLine Start="{Binding StartPoint, Converter={StaticResource ConnectionPointConverter}}"
                                  End="{Binding EndPoint, Converter={StaticResource ConnectionPointConverter}}"
                                  Control1="{Binding ControlPoint1, Converter={StaticResource ConnectionPointConverter}}"
                                  Control2="{Binding ControlPoint2, Converter={StaticResource ConnectionPointConverter}}"
                                  Style="{StaticResource ConnectionStyle}"/>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Canvas for architecture -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Canvas -->
        </Grid.RowDefinitions>

        <!-- Mini toolbar -->
        <Border Grid.Row="0" 
                Background="{StaticResource White5Brush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="Auto-layout" 
                        Command="{Binding AutoLayoutCommand}"
                        Background="{StaticResource White5Brush}"
                        Style="{StaticResource TextButtonStyle}"
                        Padding="8,4"
                        Margin="0,0,4,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4 4 L8 4 L8 8 L4 8 Z M12 4 L16 4 L16 8 L12 8 Z M4 12 L8 12 L8 16 L4 16 Z M12 12 L16 12 L16 16 L12 16 Z"
                                      Fill="{StaticResource GoldBrush}"
                                      Width="14" Height="14"
                                      Margin="0,0,4,0"/>
                                <TextBlock Text="Auto-layout" Foreground="{StaticResource White80Brush}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Content="Clear" 
                        Command="{Binding ClearCanvasCommand}"
                        Background="{StaticResource White5Brush}"
                        Style="{StaticResource TextButtonStyle}"
                        Padding="8,4"
                        Margin="0,0,4,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4 4 L16 16 M16 4 L4 16"
                                      Stroke="{StaticResource White70Brush}"
                                      StrokeThickness="1.5"
                                      Width="14" Height="14"
                                      Margin="0,0,4,0"/>
                                <TextBlock Text="Clear" Foreground="{StaticResource White70Brush}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Rectangle Width="1" Fill="{StaticResource BorderLightBrush}" Margin="8,4"/>

                <TextBlock Text="Snap: 8px" 
                           Foreground="{StaticResource White60Brush}" 
                           FontFamily="Consolas"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBlock Text="Zoom: 100%" 
                           Foreground="{StaticResource White60Brush}" 
                           FontFamily="Consolas"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Scrollable canvas area -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <Grid>
                <!-- Background grid -->
                <Rectangle Fill="{StaticResource WorkspaceBackgroundBrush}"
                           Width="{Binding CanvasWidth, FallbackValue=2000}"
                           Height="{Binding CanvasHeight, FallbackValue=1500}"/>

                <!-- Canvas for connections (below blocks) -->
                <ItemsControl ItemsSource="{Binding Connections}"
                              Width="{Binding CanvasWidth, FallbackValue=2000}"
                              Height="{Binding CanvasHeight, FallbackValue=1500}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="Transparent"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Canvas for layer blocks (above connections) - здесь используем DropBehavior -->
                <ItemsControl ItemsSource="{Binding LayerBlocks}"
                              Width="{Binding CanvasWidth, FallbackValue=2000}"
                              Height="{Binding CanvasHeight, FallbackValue=1500}"
                              behav:DropBehavior.IsDropTarget="True"
                              behav:DropBehavior.DropFormat="LayerType"
                              behav:DropBehavior.DropCommand="{Binding AddLayerCommand}"
                              behav:DropBehavior.DropPosition="{Binding MousePosition, Mode=OneWayToSource}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="Transparent"
                                    MouseMove="Canvas_MouseMove"
                                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Temporary connection while dragging -->
                <local:ConnectionLine x:Name="TempConnection"
                                      Visibility="Collapsed"
                                      Style="{StaticResource ConnectionStyle}"
                                      Opacity="0.5"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>