<!-- Views/PlaygroundView.xaml -->
<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Controls.PlaygroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels.Playground"
             xmlns:converters="clr-namespace:SharpLeNet.Vision.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:PlaygroundViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- DataTemplate для отображения класса вероятности -->
        <DataTemplate x:Key="ClassProbabilityTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Название класса и вероятность -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                          Text="{Binding ClassName}" 
                          Foreground="{Binding TextColor}"
                          FontSize="12"
                          FontWeight="{Binding FontWeight}"/>

                    <TextBlock Grid.Column="1" 
                          Text="{Binding ProbabilityDisplay}" 
                          Foreground="{Binding ValueColor}"
                          FontSize="12"
                          FontFamily="Consolas"/>
                </Grid>

                <!-- Прогресс-бар с правильным MultiBinding -->
                <Border Grid.Row="1"
                    x:Name="ProgressBarContainer"
                    Height="8"
                    Background="{StaticResource White5Brush}"
                    CornerRadius="4">

                    <Border x:Name="ProgressFill"
                        Background="{Binding BarColor}"
                        CornerRadius="4"
                        HorizontalAlignment="Left">

                        <!-- Используем MultiBinding для ширины -->
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                <Binding Path="Probability"/>
                                <Binding Path="ActualWidth" ElementName="ProgressBarContainer"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
            </Grid>

            <!-- Триггеры для победителя -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWinner}" Value="True">
                    <Setter TargetName="ProgressBarContainer" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" 
                                          Opacity="0.5" 
                                          ShadowDepth="0"
                                          Color="#10b981"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <!-- Left Panel -->
            <ColumnDefinition Width="*"/>
            <!-- Center Workspace -->
            <ColumnDefinition Width="320"/>
            <!-- Right Panel -->
        </Grid.ColumnDefinitions>

        <!-- Views/PlaygroundView.xaml - обновляем левую панель -->

        <!-- Left Panel -->
        <Border Grid.Column="0"
        Background="{StaticResource Coal800Brush}"
        BorderBrush="{StaticResource BorderLightBrush}"
        BorderThickness="0,0,1,0"
        Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Входные данные" 
                          Foreground="White" 
                          FontSize="18" 
                          FontWeight="SemiBold"/>
                        <TextBlock Text="Выберите метод загрузки теста" 
                          Foreground="{StaticResource White55Brush}" 
                          FontSize="11"/>
                    </StackPanel>

                    <!-- Input Method Selection -->
                    <StackPanel Margin="0,0,0,24">
                        <!-- Drawing Mode (Active) -->
                        <Button Style="{StaticResource InputMethodActiveStyle}"
                        Command="{Binding SelectDrawingModeCommand}"
                        Margin="0,0,0,8">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                Width="40" Height="40"
                                Background="{StaticResource Emerald500Brush}"
                                CornerRadius="8"
                                Opacity="0.2">
                                    <Path Data="{StaticResource PencilIconGeometry}"
                                  Fill="{StaticResource Emerald400Brush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Рисование" 
                                      Foreground="White" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"/>
                                    <TextBlock Text="MNIST Handwriting" 
                                      Foreground="{StaticResource White50Brush}" 
                                      FontSize="10"/>
                                </StackPanel>

                                <Path Grid.Column="2"
                              Data="{StaticResource CheckCircleIconGeometry}"
                              Fill="{StaticResource Emerald400Brush}"
                              Width="20" Height="20"
                              Stretch="Uniform"
                              Margin="0,0,4,0"/>
                            </Grid>
                        </Button>

                        <!-- File Upload Mode -->
                        <Button Style="{StaticResource InputMethodInactiveStyle}"
                        Command="{Binding SelectFileUploadCommand}"
                        Margin="0,0,0,8">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                Width="40" Height="40"
                                Background="{StaticResource White5Brush}"
                                CornerRadius="8">
                                    <Path Data="{StaticResource UploadIconGeometry}"
                                  Fill="{StaticResource White40Brush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Загрузка файла" 
                                      Foreground="{StaticResource White80Brush}" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"/>
                                    <TextBlock Text="PNG, JPG (28x28)" 
                                      Foreground="{StaticResource White40Brush}" 
                                      FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- From Dataset Mode -->
                        <Button Style="{StaticResource InputMethodInactiveStyle}"
                        Command="{Binding SelectDatasetModeCommand}">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                Width="40" Height="40"
                                Background="{StaticResource White5Brush}"
                                CornerRadius="8">
                                    <Path Data="{StaticResource LinkIconGeometry}"
                                  Fill="{StaticResource White40Brush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Из набора" 
                                      Foreground="{StaticResource White80Brush}" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"/>
                                    <TextBlock Text="Тестовая выборка" 
                                      Foreground="{StaticResource White40Brush}" 
                                      FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Height="1" 
                       Fill="{StaticResource White10Brush}" 
                       Margin="0,0,0,24"/>

                    <!-- Tool Settings -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="НАСТРОЙКИ" 
                          Foreground="{StaticResource White60Brush}" 
                          FontSize="10"
                          FontWeight="Bold"
                          Margin="0,0,0,12"/>

                        <!-- Confidence Threshold -->
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                  Text="Порог уверенности" 
                                  Foreground="{StaticResource White70Brush}" 
                                  FontSize="12"/>
                                <TextBlock Grid.Column="1" 
                                  Text="{Binding ConfidenceThreshold, StringFormat=F2}" 
                                  Foreground="{StaticResource Emerald400Brush}" 
                                  FontSize="11"
                                  FontFamily="Consolas"/>
                            </Grid>
                            <Slider Minimum="0.1" 
                            Maximum="0.95" 
                            Value="{Binding ConfidenceThreshold}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Style="{StaticResource EmeraldSliderStyle}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                  Text="0.1" 
                                  Foreground="{StaticResource White40Brush}" 
                                  FontSize="9"
                                  FontFamily="Consolas"/>
                                <TextBlock Grid.Column="1" 
                                  Text="0.95" 
                                  Foreground="{StaticResource White40Brush}" 
                                  FontSize="9"
                                  FontFamily="Consolas"
                                  HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Normalization Toggle - используем CheckBox -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
              Text="Нормализация" 
              Foreground="{StaticResource White70Brush}" 
              FontSize="12"/>
                            <CheckBox Grid.Column="1"
              Style="{StaticResource ToggleCheckBoxStyle}"
              IsChecked="{Binding NormalizationEnabled}"/>
                        </Grid>

                        <!-- Adversarial Mode Toggle - используем CheckBox -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
              Text="Adversarial Mode" 
              Foreground="{StaticResource White70Brush}" 
              FontSize="12"/>
                            <CheckBox Grid.Column="1"
              Style="{StaticResource ToggleCheckBoxStyle}"
              IsChecked="{Binding AdversarialMode}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Separator -->
                    <Rectangle Height="1" 
                       Fill="{StaticResource White10Brush}" 
                       Margin="0,0,0,24"/>

                    <!-- Action Buttons -->
                    <StackPanel>
                        <Button Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding RunModelCommand}"
                        Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="16,0">
                                <Path Data="{StaticResource PlayIconGeometry}"
                              Fill="#141414"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                                <TextBlock Text="Запустить модель" 
                                  Foreground="#141414" 
                                  FontSize="13"
                                  FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearCanvasCommand}"
                        Height="44">
                            <TextBlock Text="Очистить холст" 
                              Foreground="{StaticResource White70Brush}" 
                              FontSize="12"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Views/PlaygroundView.xaml - обновляем центральную область -->

        <!-- Center Workspace -->
        <Border Grid.Column="1"
        Background="{StaticResource Coal900Brush}"
        Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
                <StackPanel>
                    <!-- Large Input Display -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Handwriting Canvas -->
                        <Border Grid.Column="0"
                        Style="{StaticResource CanvasContainerStyle}"
                        Padding="0"
                        Height="280">
                            <Grid>
                                <!-- Canvas с сеткой -->
                                <Rectangle Fill="{StaticResource CanvasGridBrush}"
                                   Opacity="0.3"/>

                                <!-- Область рисования -->
                                <Border Background="{StaticResource Coal950Brush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="20"
                                Cursor="Cross">

                                    <!-- Симулированное изображение цифры 8 для демо -->
                                    <Grid>
                                        <Path Data="M30,30 Q50,10 70,30 T70,70 Q50,90 30,70 T30,30"
                                      Stroke="{StaticResource White80Brush}"
                                      StrokeThickness="12"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Opacity="0.9"
                                      Stretch="Uniform"
                                      Margin="20"/>

                                        <!-- Подпись внизу -->
                                        <TextBlock Text="28 × 28 • Input View"
                                          Foreground="{StaticResource White30Brush}"
                                          FontSize="10"
                                          FontFamily="Consolas"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,8,8"/>
                                    </Grid>
                                </Border>

                                <!-- Режим отображения -->
                                <Border Background="{StaticResource Emerald500Brush}"
                                BorderBrush="{StaticResource Emerald400Brush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="12">
                                    <TextBlock Text="Drawing Mode"
                                      Foreground="White"
                                      FontSize="9"
                                      FontWeight="Bold"
                                      FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Feature Map Preview -->
                        <Border Grid.Column="2"
                        Style="{StaticResource CanvasContainerStyle}"
                        Padding="16"
                        Height="280">
                            <StackPanel>
                                <!-- Заголовок -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Path Data="{StaticResource GridIconGeometry}"
                                      Fill="{StaticResource GoldBrush}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                        <TextBlock Text="Активации: Conv2D_Layer_1"
                                          Foreground="{StaticResource White70Brush}"
                                          FontSize="11"
                                          FontWeight="Medium"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                      Text="{Binding ActiveLayerName}"
                                      Foreground="{StaticResource White40Brush}"
                                      FontSize="10"
                                      FontFamily="Consolas"
                                      HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Feature Map Grid -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Генерируем 16 ячеек (4x4) -->
                                    <Border Grid.Row="0" Grid.Column="0"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource Emerald500Brush}" Opacity="0.3"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource GoldBrush}" Opacity="0.2"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="2"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource Emerald500Brush}" Opacity="0.4"/>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="3"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="White" Opacity="0.1"/>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="White" Opacity="0.15"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource Emerald500Brush}" Opacity="0.5"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource GoldBrush}" Opacity="0.3"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="3"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource Emerald500Brush}" Opacity="0.2"/>
                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="0"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource GoldBrush}" Opacity="0.25"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="White" Opacity="0.1"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="2"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource Emerald500Brush}" Opacity="0.45"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="3"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource GoldBrush}" Opacity="0.2"/>
                                    </Border>

                                    <Border Grid.Row="3" Grid.Column="0"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource Emerald500Brush}" Opacity="0.3"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="1"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource GoldBrush}" Opacity="0.35"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="2"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="White" Opacity="0.2"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="3"
                                    Background="{StaticResource Coal950Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0.5"
                                    Margin="1">
                                        <Rectangle Fill="{StaticResource Emerald500Brush}" Opacity="0.4"/>
                                    </Border>
                                </Grid>

                                <!-- Ссылка "Показать все слои" -->
                                <Button Style="{StaticResource TextButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Показать все слои"
                                          Foreground="{StaticResource Emerald400Brush}"
                                          FontSize="11"
                                          FontWeight="Medium"/>
                                        <Path Data="{StaticResource ExternalLinkIconGeometry}"
                                      Stroke="{StaticResource Emerald400Brush}"
                                      StrokeThickness="1.5"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Inference Results Bottom Strip -->
                    <Border Style="{StaticResource CanvasContainerStyle}"
                    Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Результат предсказания -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="60" Height="60"
                                Background="{StaticResource Emerald500Brush}"
                                CornerRadius="16"
                                Effect="{StaticResource GlowEmerald}">
                                    <TextBlock Text="{Binding PredictedClass}"
                                      Foreground="{StaticResource Coal950Brush}"
                                      FontSize="32"
                                      FontWeight="Black"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Предсказание"
                                      Foreground="{StaticResource Emerald400Brush}"
                                      FontSize="10"
                                      FontWeight="Bold"/>
                                    <TextBlock Text="{Binding PredictedClassName}"
                                      Foreground="White"
                                      FontSize="24"
                                      FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ConfidenceDisplay}"
                                      Foreground="{StaticResource White50Brush}"
                                      FontSize="12"
                                      FontFamily="Consolas"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Разделитель -->
                            <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="{StaticResource White10Brush}"
                               Margin="24,0"/>

                            <!-- Метрики -->
                            <Grid Grid.Column="2" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Inference Time -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Inference Time"
                                      Foreground="{StaticResource White40Brush}"
                                      FontSize="9"
                                      FontWeight="Bold"/>
                                    <TextBlock Text="{Binding InferenceTime, StringFormat={}{0:F1}ms}"
                                      Foreground="White"
                                      FontSize="16"
                                      FontFamily="Consolas"
                                      FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Device -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Device"
                                      Foreground="{StaticResource White40Brush}"
                                      FontSize="9"
                                      FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Device}"
                                      Foreground="White"
                                      FontSize="16"
                                      FontFamily="Consolas"
                                      FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Entropy -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Entropy"
                                      Foreground="{StaticResource White40Brush}"
                                      FontSize="9"
                                      FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Entropy, StringFormat=F3}"
                                      Foreground="White"
                                      FontSize="16"
                                      FontFamily="Consolas"
                                      FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Export Button -->
                                <Button Grid.Column="3"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ExportJsonCommand}"
                                Padding="16,0"
                                Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource DownloadIconGeometry}"
                                      Stroke="{StaticResource White70Brush}"
                                      StrokeThickness="1.5"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"/>
                                        <TextBlock Text="Экспорт JSON"
                                          Foreground="{StaticResource White70Brush}"
                                          FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Panel -->
        <Border Grid.Column="2"
        Background="{StaticResource Coal800Brush}"
        BorderBrush="{StaticResource BorderLightBrush}"
        BorderThickness="1,0,0,0"
        Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Распределение" 
                          Foreground="White" 
                          FontSize="18" 
                          FontWeight="SemiBold"/>
                        <TextBlock Text="Вероятности для всех классов" 
                          Foreground="{StaticResource White55Brush}" 
                          FontSize="11"/>
                    </StackPanel>

                    <!-- Probability Bars -->
                    <ItemsControl ItemsSource="{Binding ClassProbabilities}"
                          ItemTemplate="{StaticResource ClassProbabilityTemplate}"
                          Margin="0,0,0,24"/>

                    <!-- Model Insight Card -->
                    <Border Background="{StaticResource Gold500Brush}"
                    Opacity="0.05"
                    BorderBrush="{StaticResource Gold400Brush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="{StaticResource AlertTriangleIconGeometry}"
                              Stroke="{StaticResource Gold400Brush}"
                              StrokeThickness="1.5"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              Margin="0,0,8,0"/>
                                <TextBlock Text="ИНСАЙТ МОДЕЛИ"
                                  Foreground="{StaticResource Gold400Brush}"
                                  FontSize="10"
                                  FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Insight Text -->
                            <TextBlock Text="{Binding ModelInsight}"
                              Foreground="{StaticResource White60Brush}"
                              FontSize="12"
                              TextWrapping="Wrap"
                              LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Add to Training Log Button -->
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding AddToTrainingLogCommand}"
                    Height="44">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DatabaseIconGeometry}"
                          Stroke="{StaticResource White50Brush}"
                          StrokeThickness="1.5"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                            <TextBlock Text="Добавить в лог обучения"
                              Foreground="{StaticResource White50Brush}"
                              FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>