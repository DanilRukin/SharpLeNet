<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Controls.RibbonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SharpLeNet.Vision.Wpf.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1440">
    <UserControl.Resources>
        <!-- Стиль для кнопок меню - ИСПРАВЛЕН -->
        <Style x:Key="RibbonMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="8,0">
                                <!-- Иконка из Tag -->
                                <ContentControl Content="{TemplateBinding Tag}"
                                              Width="18" Height="18"
                                              Margin="0,0,4,0"/>
                                <!-- Текст из Content -->
                                <TextBlock Text="{TemplateBinding Content}"
                                         Foreground="{TemplateBinding Foreground}"
                                         FontSize="13"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource White10Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource White20Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для иконок в виде Path (без изменений) -->
        <Style x:Key="MenuIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource GoldBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>

        <!-- Иконки как Path (без DataTemplate) -->
        <Path x:Key="HomeIcon" Style="{StaticResource MenuIconStyle}" 
              Data="M3 10 L12 3 L21 10 L21 21 L15 21 L15 15 L9 15 L9 21 L3 21 Z"/>

        <Path x:Key="FileIcon" Style="{StaticResource MenuIconStyle}" 
              Data="M4 4 L20 4 L20 20 L4 20 Z M8 8 L16 8 M8 12 L16 12 M8 16 L13 16"/>

        <Path x:Key="ViewIcon" Style="{StaticResource MenuIconStyle}" 
              Data="M2 12 C6 4 18 4 22 12 C18 20 6 20 2 12 M12 8 C14 8 16 10 16 12 C16 14 14 16 12 16 C10 16 8 14 8 12 C8 10 10 8 12 8"/>

        <Path x:Key="HelpIcon" Style="{StaticResource MenuIconStyle}" 
              Data="M12 2 C6 2 2 6 2 12 C2 18 6 22 12 22 C18 22 22 18 22 12 C22 6 18 2 12 2 M12 8 L12 12 M12 16 L12.01 16"/>

        <Path x:Key="ZapIcon" Style="{StaticResource MenuIconStyle}" 
              Data="M13 2 L4 14 L12 14 L11 22 L20 10 L12 10 L13 2" 
              Fill="{StaticResource GoldBrush}" Stroke="{StaticResource GoldDarkBrush}"/>

        <Path x:Key="SettingsIcon" Style="{StaticResource MenuIconStyle}" 
              Data="M12 2 L12 6 M12 18 L12 22 M4 12 L2 12 M22 12 L20 12 M6 6 L4 4 M18 18 L20 20 M6 18 L4 20 M18 6 L20 4 M8 12 C8 10 10 8 12 8 C14 8 16 10 16 12 C16 14 14 16 12 16 C10 16 8 14 8 12"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main ribbon row -->
        <Grid Grid.Row="0" Margin="16,8,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <!-- Фиксированная ширина для поиска -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo and title (без изменений) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                <Border Width="40" Height="40"
                        CornerRadius="12"
                        Background="{StaticResource Black20Brush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1">
                    <Viewbox Width="22" Height="22">
                        <Path Data="M4 8 L20 8 L20 24 L4 24 Z M8 12 L16 12 L16 20 L8 20 Z M24 4 L40 4 L40 28 L24 28 Z M28 8 L36 8 L36 24 L28 24 Z"
                              Fill="{StaticResource GoldBrush}"/>
                    </Viewbox>
                </Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SharpLeNet Vision" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="16"/>
                    <TextBlock Text="Визуальная лаборатория компьютерного зрения" 
                               Foreground="{StaticResource White60Brush}" 
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <!-- Menu items - ИСПРАВЛЕНО: убраны DataTemplate, используются прямые ресурсы -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Home" 
                        Tag="{StaticResource HomeIcon}"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ShowHomeMenuCommand}"/>
                <Button Content="File" 
                        Tag="{StaticResource FileIcon}"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ShowFileMenuCommand}"/>
                <Button Content="View" 
                        Tag="{StaticResource ViewIcon}"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ShowViewMenuCommand}"/>
                <Button Content="Help" 
                        Tag="{StaticResource HelpIcon}"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ShowHelpMenuCommand}"/>
            </StackPanel>

            <!-- Spacer -->
            <Grid Grid.Column="2"/>

            <!-- Search box - ИСПРАВЛЕНО: фиксированная ширина и отключено расширение -->
            <Border Grid.Column="3" 
                    Background="{StaticResource White5Brush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="36"
                    Width="250">
                <!-- Фиксированная ширина -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" 
                          Data="M15 15 L21 21 M10 16 C6 16 3 13 3 9 C3 5 6 2 10 2 C14 2 17 5 17 9 C17 13 14 16 10 16"
                          Stroke="{StaticResource White60Brush}"
                          StrokeThickness="2"
                          Width="18" Height="18"
                          Margin="8,0,4,0"/>

                    <TextBox Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="13"
                             VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск слоёв, параметров, метрик..."
                             MaxLength="50">
                        <!-- Ограничение длины текста -->
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,0"
                                                            HorizontalScrollBarVisibility="Hidden"
                                                            VerticalScrollBarVisibility="Disabled"/>
                                                <TextBlock x:Name="Watermark"
                                                         Text="Поиск слоёв, параметров, метрик…"
                                                         Foreground="{StaticResource White40Brush}"
                                                         IsHitTestVisible="False"
                                                         Visibility="Collapsed"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Border Grid.Column="2"
                            Background="{StaticResource White10Brush}"
                            CornerRadius="4"
                            Margin="0,4,8,4"
                            Padding="4,2">
                        <TextBlock Text="Ctrl K" 
                                   Foreground="{StaticResource White40Brush}" 
                                   FontSize="10"
                                   FontFamily="Consolas"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Action buttons -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="Быстрый старт"
                    Tag="{StaticResource ZapIcon}"
                    Style="{StaticResource AccentButtonStyle}"
                    Height="36"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    Cursor="Hand"/>

                <!-- Для кнопки с только иконкой -->
                <Button Tag="{StaticResource SettingsIcon}"
                    Style="{StaticResource SquareIconButtonStyle}"
                    Width="36" Height="36"
                    Background="{StaticResource White5Brush}"
                    Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Secondary strip (без изменений) -->
        <Border Grid.Row="1" 
                Background="{StaticResource White5Brush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Project status -->
                <Border Grid.Column="0"
                        Background="{StaticResource Black10Brush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10"
                                Fill="#4ade80"
                                Margin="0,0,8,0"
                                Stroke="{StaticResource White20Brush}"
                                StrokeThickness="1"/>
                        <TextBlock Text="Проект: " 
                                   Foreground="{StaticResource White60Brush}" 
                                   FontSize="12"/>
                        <TextBlock Text="{Binding ProjectName}" 
                                   Foreground="White" 
                                   FontWeight="Medium" 
                                   FontSize="12"/>
                        <Rectangle Width="1" Height="16"
                                   Fill="{StaticResource White20Brush}"
                                   Margin="8,0"/>
                        <TextBlock Text="Режим: " 
                                   Foreground="{StaticResource White60Brush}" 
                                   FontSize="12"/>
                        <TextBlock Text="{Binding CurrentMode}" 
                                   Foreground="{StaticResource White90Brush}" 
                                   FontWeight="Medium" 
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Right side buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Height="32"
                            Style="{StaticResource TextButtonStyle}"
                            Background="{StaticResource White5Brush}"
                            Padding="12,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8 6 L22 12 L8 18 Z"
                                  Fill="{StaticResource GoldBrush}"
                                  Width="12" Height="12"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Start" Foreground="{StaticResource White90Brush}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Height="32"
                            Background="{StaticResource White5Brush}"
                            Style="{StaticResource TextButtonStyle}"
                            Padding="12,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="8" Height="10"
                                      Fill="{StaticResource White70Brush}"
                                      Margin="0,0,6,0"/>
                            <TextBlock Text="Pause" Foreground="{StaticResource White70Brush}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Height="32"
                            Background="{StaticResource White5Brush}"
                            Style="{StaticResource TextButtonStyle}"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="10"
                                      Fill="#f87171"
                                      Margin="0,0,6,0"/>
                            <TextBlock Text="Stop" Foreground="{StaticResource White70Brush}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>