<!-- Views/Controls/LayerBlock.xaml (исправленный) -->
<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Controls.LayerBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels"
             xmlns:behav="clr-namespace:SharpLeNet.Vision.Wpf.Behaviors"
             xmlns:converters="clr-namespace:SharpLeNet.Vision.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="210"
             d:DataContext="{d:DesignInstance viewModels:LayerBlockViewModel}"
             IsHitTestVisible="True">

    <!-- Единый корневой элемент - Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Блок слоя -->
            <RowDefinition Height="Auto"/>
            <!-- Output dimension -->
        </Grid.RowDefinitions>

        <!-- Контейнер для блока и индикатора выбора -->
        <Grid Grid.Row="0">
            <!-- Блок слоя -->
            <Border Background="{Binding BackgroundGradient, Converter={StaticResource StringToGradientConverter}}"
                    BorderBrush="{Binding BorderColor, Converter={StaticResource StringToBrushConverter}}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Effect="{Binding IsSelected, Converter={StaticResource BoolToEffectConverter}}"
                    behav:DragDropBehavior.IsDragSource="True"
                    behav:DragDropBehavior.DragData="{Binding}"
                    behav:DragDropBehavior.DragFormat="LayerBlock">

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                Background="{StaticResource Black20Brush}"
                                BorderBrush="{Binding BorderColor, Converter={StaticResource StringToBrushConverter}}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentControl Content="{Binding Icon, Converter={StaticResource IconConverter}}"
                                          Width="18" Height="18"
                                          Foreground="{Binding Color, Converter={StaticResource StringToBrushConverter}}"/>
                        </Border>

                        <!-- Title and subtitle -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" 
                                       Foreground="White" 
                                       FontWeight="SemiBold" 
                                       FontSize="14"/>
                            <TextBlock Text="{Binding Subtitle}" 
                                       Foreground="{StaticResource White60Brush}" 
                                       FontSize="11"/>
                        </StackPanel>

                        <!-- ID -->
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding Id}" 
                                   Foreground="{StaticResource White55Brush}" 
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Parameters -->
                    <ItemsControl Grid.Row="1" 
                                  Margin="0,12,0,0"
                                  ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Black20Brush}"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="2"
                                        Padding="8,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" 
                                                   Foreground="{StaticResource White55Brush}" 
                                                   FontSize="9"/>
                                        <TextBlock Text="{Binding Value}" 
                                                   Foreground="{StaticResource White80Brush}" 
                                                   FontFamily="Consolas"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Selection indicator (поверх блока) -->
            <Border BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="2"
                    CornerRadius="16"
                    Background="Transparent"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- Output dimension below block -->
        <TextBlock Grid.Row="1"
                   Text="{Binding OutputDim}" 
                   Foreground="{StaticResource White60Brush}"
                   FontFamily="Consolas"
                   FontSize="10"
                   Margin="0,4,0,0"
                   HorizontalAlignment="Center"/>
    </Grid>
</UserControl>