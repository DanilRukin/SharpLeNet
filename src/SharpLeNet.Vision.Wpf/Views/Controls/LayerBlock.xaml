<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Controls.LayerBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SharpLeNet.Vision.Wpf.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Width="210" 
            CornerRadius="16"
            Background="{Binding BackgroundGradient}"
            BorderBrush="{Binding BorderColor}"
            BorderThickness="1"
            Effect="{StaticResource BlockShadow}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border Grid.Column="0" 
                        Width="36" Height="36"
                        CornerRadius="12"
                        Background="#33000000"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="1">
                    <ContentControl Content="{Binding Icon, Converter={StaticResource IconConverter}}"/>
                </Border>

                <!-- Title/Subtitle -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Name}" 
                               Foreground="White" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" 
                               Foreground="#A6FFFFFF" 
                               FontSize="11"/>
                </StackPanel>

                <!-- ID -->
                <TextBlock Grid.Column="2" 
                           Text="{Binding Id}" 
                           Foreground="#8CFFFFFF" 
                           FontFamily="Consolas"
                           FontSize="10"/>
            </Grid>

            <!-- Parameters Grid -->
            <ItemsControl Grid.Row="1" 
                          Margin="0,12,0,0"
                          ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#33000000"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="2"
                                Padding="8,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" 
                                           Foreground="#8CFFFFFF" 
                                           FontSize="9"/>
                                <TextBlock Text="{Binding Value}" 
                                           Foreground="#D9FFFFFF" 
                                           FontFamily="Consolas"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>

    <!-- Output dimension label below block -->
    <!--<TextBlock Text="{Binding OutputDim}" 
               Foreground="#99FFFFFF"
               FontFamily="Consolas"
               FontSize="10"
               Margin="0,4,0,0"/>-->
</UserControl>
