<!-- Views/StatusBarView.xaml -->
<UserControl x:Class="SharpLeNet.Vision.Wpf.Views.Controls.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:SharpLeNet.Vision.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="58" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance viewModels:StatusBarViewModel}">

    <UserControl.Resources>

        <!-- Стиль для индикатора с пульсацией -->
        <Style x:Key="PulsingEllipseStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#4ade80"/>
            <Setter Property="Stroke" Value="{StaticResource White20Brush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComputing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation 
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.3" To="1" Duration="0:0:0.8"
                                    AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для градиентного прогресс-бара -->
        <Style x:Key="GradientProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#4ade80" Offset="0.0"/>
                        <GradientStop Color="#facc15" Offset="0.5"/>
                        <GradientStop Color="#f87171" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="{StaticResource White10Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}"
                                           RadiusX="4" RadiusY="4"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- GPU/CPU индикатор -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>

            <!-- VRAM usage -->
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>

            <!-- Training progress -->
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="Auto"/>

            <!-- LR + ETA -->
            <ColumnDefinition Width="Auto"/>

            <!-- Flex space -->
            <ColumnDefinition Width="*"/>

            <!-- Sparkline -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- GPU/CPU индикатор -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0">
            <Grid>
                <Ellipse Style="{StaticResource PulsingEllipseStyle}"/>
                <Ellipse Width="10" Height="10"
                        Fill="#4ade80"
                        Opacity="0.3"
                        RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Compute" 
                          Foreground="{StaticResource White60Brush}" 
                          FontSize="10"/>
                <TextBlock Text="{Binding ComputeDevice}" 
                          Foreground="White" 
                          FontWeight="SemiBold" 
                          FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Разделитель -->
        <Rectangle Grid.Column="1" 
                   Width="1" 
                   Fill="{StaticResource White10Brush}" 
                   Margin="20,0,0,0"/>

        <!-- VRAM usage -->
        <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                          Text="VRAM" 
                          Foreground="{StaticResource White60Brush}" 
                          FontSize="10"/>
                <TextBlock Grid.Column="1" 
                          Text="{Binding VramDisplay}" 
                          Foreground="{StaticResource White55Brush}" 
                          FontFamily="Consolas"
                          FontSize="10"/>
            </Grid>
            <ProgressBar Value="{Binding VramPercentage, Mode=OneWay}" 
                        Style="{StaticResource GradientProgressBarStyle}"
                        Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Разделитель -->
        <Rectangle Grid.Column="3" 
                   Width="1" 
                   Fill="{StaticResource White10Brush}" 
                   Margin="20,0,0,0"/>

        <!-- Training progress -->
        <StackPanel Grid.Column="4" Margin="20,0,0,0" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Training" 
                              Foreground="{StaticResource White60Brush}" 
                              FontSize="10"/>
                    <Border Background="{StaticResource White5Brush}"
                           BorderBrush="{StaticResource BorderLightBrush}"
                           BorderThickness="1"
                           CornerRadius="4"
                           Padding="6,2"
                           Margin="8,0,0,0">
                        <TextBlock Text="{Binding EpochDisplay}" 
                                  Foreground="{StaticResource White60Brush}" 
                                  FontFamily="Consolas"
                                  FontSize="10"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" 
                          Text="{Binding BatchDisplay}" 
                          Foreground="{StaticResource White55Brush}" 
                          FontFamily="Consolas"
                          FontSize="10"/>
            </Grid>
            <ProgressBar Value="{Binding BatchProgress, Mode=OneWay}" 
                        Style="{StaticResource GradientProgressBarStyle}"
                        Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Разделитель -->
        <Rectangle Grid.Column="5" 
                   Width="1" 
                   Fill="{StaticResource White10Brush}" 
                   Margin="20,0,0,0"/>

        <!-- LR + ETA -->
        <StackPanel Grid.Column="6" Margin="20,0,0,0" Orientation="Horizontal">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="LR" 
                          Foreground="{StaticResource White60Brush}" 
                          FontSize="10"/>
                <TextBlock Text="{Binding LearningRateDisplay}" 
                          Foreground="{StaticResource White80Brush}" 
                          FontFamily="Consolas"
                          FontSize="12"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="ETA" 
                          Foreground="{StaticResource White60Brush}" 
                          FontSize="10"/>
                <TextBlock Text="{Binding EtaDisplay}" 
                          Foreground="{StaticResource White80Brush}" 
                          FontFamily="Consolas"
                          FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Sparkline (справа) -->
        <Border Grid.Column="8" 
                Background="{StaticResource White5Brush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,6"
                Margin="0,0,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Loss (train)" 
                              Foreground="{StaticResource White60Brush}" 
                              FontSize="10"/>
                    <TextBlock Text="{Binding CurrentLossDisplay}" 
                              Foreground="White" 
                              FontWeight="SemiBold"
                              FontSize="14"/>
                </StackPanel>

                <!-- Простой спарклайн -->
                <Canvas Grid.Column="1" Width="100" Height="30" ClipToBounds="True">
                    <Polyline Points="{Binding SparklinePoints}"
                             Stroke="{StaticResource GoldBrush}"
                             StrokeThickness="2"
                             Fill="Transparent"/>

                    <!-- Заливка под линией -->
                    <Polygon Points="{Binding SparklineFillPoints}"
                            Fill="{StaticResource GoldBrush}"
                            Opacity="0.15"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>