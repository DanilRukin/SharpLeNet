<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window Button Style -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для кнопки закрытия (отдельный, не BasedOn) -->
    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#C42B1C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#A11F12"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Window Style -->
    <Style x:Key="CustomWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource MainBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
        <Setter Property="Foreground" Value="{StaticResource White80Brush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Grid>
                        <Border x:Name="WindowBorder" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="16"/>
                                </Grid.RowDefinitions>

                                <!-- Title Bar -->
                                <Border x:Name="PART_TitleBar"
                                    Grid.Row="0" 
                                    Background="{StaticResource PanelHeaderBrush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="16,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Window Icon and Title -->
                                        <StackPanel Grid.Column="0" 
                                                Orientation="Horizontal" 
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="🔬" FontSize="16" Foreground="{StaticResource GoldBrush}"/>
                                            <TextBlock Text="SharpLeNet Vision" 
                                                   Foreground="{StaticResource White90Brush}"
                                                   FontWeight="SemiBold"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Пустое пространство для перетаскивания -->
                                        <Grid x:Name="PART_DragArea"
                                          Grid.Column="1"
                                          Background="Transparent"/>

                                        <!-- Window Controls -->
                                        <StackPanel Grid.Column="2" 
                                                Orientation="Horizontal" 
                                                Margin="0,0,12,0">
                                            <Button x:Name="PART_MinimizeButton" 
                                                Style="{StaticResource WindowButtonStyle}">
                                                <TextBlock Text="─" FontSize="16" Foreground="{StaticResource White60Brush}"/>
                                            </Button>
                                            <Button x:Name="PART_MaximizeButton" 
                                                 Style="{StaticResource WindowButtonStyle}">
                                                <TextBlock Text="□" FontSize="14" Foreground="{StaticResource White60Brush}"/>
                                            </Button>
                                            <Button x:Name="PART_CloseButton" 
                                                Style="{StaticResource CloseButtonStyle}">
                                                <!-- Используем специальный стиль -->
                                                <TextBlock Text="×" FontSize="18" Foreground="{StaticResource White60Brush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Content -->
                                <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}"/>

                                <!-- Resize Grip -->
                                <Grid Grid.Row="2">
                                    <Path Data="M0,0 L16,16 M8,0 L16,8" 
                                      Stroke="{StaticResource White20Brush}"
                                      StrokeThickness="1"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,8,8"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Ribbon Style (добавляем недостающий стиль) -->
    <Style x:Key="RibbonStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- Side Panel Style -->
    <Style x:Key="SidePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>

    <!-- Status Bar Style -->
    <Style x:Key="StatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

</ResourceDictionary>