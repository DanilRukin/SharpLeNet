<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layer Palette Button Style -->
    <Style x:Key="LayerPaletteButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="64"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{StaticResource SmallShadow}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Effect="{TemplateBinding Effect}">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    Background="{StaticResource Black10Brush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <ContentControl Content="{TemplateBinding Tag}"
                                              Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </Border>

                            <!-- Text -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}"
                                         Foreground="White"
                                         FontWeight="SemiBold"
                                         FontSize="14"/>
                                <TextBlock Text="{TemplateBinding ToolTip}"
                                         Foreground="{StaticResource White60Brush}"
                                         FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource White10Brush}"/>
                            <Setter Property="Effect" Value="{StaticResource GlowEffect}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource White15Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>